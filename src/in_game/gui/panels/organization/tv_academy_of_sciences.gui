# Towards Victory — Academy of Sciences IO Panel
# Provides the interactive research mechanism UI: research target selection,
# subprocess A/B/C/D status display, and action buttons.
# The Chief Scientist (IO leader character) is shown in the standard IO header.
#
# Verification — Step 3, Reference: union_header.gui:12
#   Quote: "datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderScopeObjectAtIndex('(int32)0').GetCharacter]""

organization_panel = {

	blockoverride "organization_overview_tab_visible" {}

	blockoverride "organization_panel_overview_visible" {
		visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
	}

	blockoverride "organization_members_tab_down" {
		down = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	blockoverride "organization_panel_members_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	blockoverride "scroll_overview_empty_visible" { visible = no }

	blockoverride "io_main_actions_icon" {
		texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetIcon]"
	}

	blockoverride "organization_main_actions_extra_visible" {
		visible = yes
	}

	blockoverride "organization_main_actions_extra" {

		# ── Research Status Overview ──────────────────────────────────────────
		widget = {
			size = { 470 200 }
			datacontext = "[InternationalOrganizationsView.GetPlayer]"

			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4
				margin = { 4 6 }

				# ── Current Research Target ───────────────────────────────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = {
						text = "TV_ACADEMY_TARGET_ADVANCE_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						visible = "[Not(Country.MakeScope.GetVariable('tv_research_target').IsSet)]"
						text = "TV_ACADEMY_TARGET_NONE"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_research_target').GetValue, '(CFixedPoint)1.0')]"
						text = "TV_RM_TARGET_PRINTING_PRESS"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_research_target').GetValue, '(CFixedPoint)2.0')]"
						text = "TV_RM_TARGET_IRON_WORKING"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_research_target').GetValue, '(CFixedPoint)3.0')]"
						text = "TV_RM_TARGET_ANATOMY"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_research_target').GetValue, '(CFixedPoint)4.0')]"
						text = "TV_RM_TARGET_GUNPOWDER"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_research_target').GetValue, '(CFixedPoint)5.0')]"
						text = "TV_RM_TARGET_BLAST_FURNACE"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_research_target').GetValue, '(CFixedPoint)6.0')]"
						text = "TV_RM_TARGET_SCIENTIFIC_EXPERIMENTATION"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_research_target').GetValue, '(CFixedPoint)7.0')]"
						text = "TV_RM_TARGET_SCIENTIFIC_REVOLUTION"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_research_target').GetValue, '(CFixedPoint)8.0')]"
						text = "TV_RM_TARGET_MANUFACTORIES"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_research_target').GetValue, '(CFixedPoint)9.0')]"
						text = "TV_RM_TARGET_INDUSTRIALIZATION"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_research_target').GetValue, '(CFixedPoint)10.0')]"
						text = "TV_RM_TARGET_VACCINATION"
						align = nobaseline
					}
				}

				# ── Selection Cooldown ────────────────────────────────────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					visible = "[Country.MakeScope.GetVariable('tv_research_selection_cd').IsSet]"
					text_single = {
						text = "TV_RM_SELECTION_CD_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						raw_text = "[Country.MakeScope.GetVariable('tv_research_selection_cd').GetValue|0]"
						align = nobaseline
					}
				}

				# ── Chief Scientist (appointed IO Leader character) ───────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					visible = "[Country.MakeScope.GetVariable('tv_academy_leader_char').IsSet]"
					text_single = {
						text = "TV_RM_CHIEF_SCIENTIST_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderScopeObjectAtIndex('(int32)0').GetCharacter]"
						text = "[Character.GetShortNameWithNoTooltip]"
						align = nobaseline
					}
				}

				# ── Subprocess A: Interest Collection ─────────────────────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = {
						text = "TV_ACADEMY_SUBPROCESS_A_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						raw_text = "[Country.MakeScope.GetVariable('tv_research_interest').GetValue|0]/5"
						visible = "[Country.MakeScope.GetVariable('tv_research_interest').IsSet]"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_a').GetValue, '(CFixedPoint)0.0')]"
						text = "TV_RM_STATUS_NOT_STARTED"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_a').GetValue, '(CFixedPoint)1.0')]"
						text = "TV_RM_STATUS_IN_PROGRESS"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_a').GetValue, '(CFixedPoint)2.0')]"
						text = "TV_RM_STATUS_COMPLETE"
						align = nobaseline
					}
				}

				# ── Subprocess B: Technology Prerequisites ─────────────────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = {
						text = "TV_ACADEMY_SUBPROCESS_B_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						visible = "[Not(EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_b').GetValue, '(CFixedPoint)2.0'))]"
						text = "TV_RM_STATUS_NOT_STARTED"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_b').GetValue, '(CFixedPoint)2.0')]"
						text = "TV_RM_STATUS_COMPLETE"
						align = nobaseline
					}
				}

				# ── Subprocess C: Literacy Foundation ─────────────────────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = {
						text = "TV_ACADEMY_SUBPROCESS_C_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_c').GetValue, '(CFixedPoint)0.0')]"
						text = "TV_RM_STATUS_NOT_STARTED"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_c').GetValue, '(CFixedPoint)1.0')]"
						raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText('tv_research_c_progress')]"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_c').GetValue, '(CFixedPoint)2.0')]"
						text = "TV_RM_STATUS_COMPLETE"
						align = nobaseline
					}
				}

				# ── Subprocess D: Concentrated Research ───────────────────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = {
						text = "TV_ACADEMY_SUBPROCESS_D_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						visible = "[Not(EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_d_ready').GetValue, '(CFixedPoint)1.0'))]"
						text = "TV_RM_STATUS_NOT_READY"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_d_ready').GetValue, '(CFixedPoint)1.0')]"
						text = "TV_RM_STATUS_READY"
						align = nobaseline
					}
					text_single = {
						visible = "[Country.MakeScope.GetVariable('tv_research_phase').IsSet]"
						raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText('tv_research_d_progress')]"
						align = nobaseline
					}
				}
			}
		}

		# ── Action Buttons ────────────────────────────────────────────────────

		# Request Research Target (disabled when cooldown active or target already set)
		action_button_diamond = {
			size = { 470 30 }
			text = "TV_RM_REQUEST_TARGET_BTN"
			title = "TV_RM_REQUEST_TARGET_BTN"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_request_research_target"
			}
		}

		# Abandon Target (visible when target is set)
		action_button_diamond = {
			size = { 470 30 }
			text = "TV_RM_ABANDON_TARGET_BTN"
			title = "TV_RM_ABANDON_TARGET_BTN"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_abandon_research_target"
			}
		}

		# Begin Concentrated Research (visible when A+B+C complete and D not started)
		action_button_diamond = {
			size = { 470 30 }
			text = "TV_RM_START_D_BTN"
			title = "TV_RM_START_D_BTN"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_start_concentrated_research"
			}
		}

		# ── IO Leader management ──────────────────────────────────────────
		action_button_diamond = {
			size = { 470 30 }
			visible = "[Not(Country.MakeScope.GetVariable('tv_academy_leader_char').IsSet)]"
			datacontext = "[InternationalOrganizationsView.GetPlayer]"
			text = "tv_appoint_academy_leader"
			title = "tv_appoint_academy_leader"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_appoint_academy_leader"
			}
		}
		action_button_diamond = {
			size = { 470 30 }
			visible = "[Country.MakeScope.GetVariable('tv_academy_leader_char').IsSet]"
			datacontext = "[InternationalOrganizationsView.GetPlayer]"
			text = "tv_change_academy_leader"
			title = "tv_change_academy_leader"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_change_academy_leader"
			}
		}
		action_button_diamond = {
			size = { 470 30 }
			visible = "[Country.MakeScope.GetVariable('tv_academy_leader_char').IsSet]"
			datacontext = "[InternationalOrganizationsView.GetPlayer]"
			text = "tv_remove_academy_leader"
			title = "tv_remove_academy_leader"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_remove_academy_leader"
			}
		}
	}
}
