				blockoverride "common_bottom_content" {

		# ── Research Status Overview ────────────────────────────────────────────────────────────────────
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = fixed
			ignoreinvisible = yes
			spacing = 4
			margin = { 4 6 }

				# ── Subprocess A: Interest Collection ─────────────────────────────────────────────────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = {
						text = "TV_ACADEMY_SUBPROCESS_A_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						raw_text = "[Country.MakeScope.GetVariable('tv_research_interest').GetValue|0]/5"
						visible = "[Country.MakeScope.GetVariable('tv_research_interest').IsSet]"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_a').GetValue, '(CFixedPoint)0.0')]"
						text = "TV_RM_STATUS_NOT_STARTED"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_a').GetValue, '(CFixedPoint)1.0')]"
						text = "TV_RM_STATUS_IN_PROGRESS"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_a').GetValue, '(CFixedPoint)2.0')]"
						text = "TV_RM_STATUS_COMPLETE"
						align = nobaseline
					}
				}
				progressbar = {
					size = { 440 16 }
					using = progress_bar_blue_alt
					min = 0
					max = 5
					value = "[Country.MakeScope.GetVariable('tv_research_interest').GetValue]"
					visible = "[Country.MakeScope.GetVariable('tv_rm_subprocess_a').IsSet]"
				}

				# ── Subprocess B: Technology Prerequisites ────────────────────────────────────────────────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = {
						text = "TV_ACADEMY_SUBPROCESS_B_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						visible = "[Not(EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_b').GetValue, '(CFixedPoint)2.0'))]"
						text = "TV_RM_STATUS_NOT_STARTED"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_b').GetValue, '(CFixedPoint)2.0')]"
						text = "TV_RM_STATUS_COMPLETE"
						align = nobaseline
					}
				}
				progressbar = {
					size = { 440 16 }
					using = progress_bar_blue_alt
					min = 0
					max = 2
					value = "[Country.MakeScope.GetVariable('tv_rm_subprocess_b').GetValue]"
				}

				text_single = {
					visible = "[Country.MakeScope.GetVariable('tv_research_target').IsSet]"
					text = "TV_RM_SUBPROCESS_B_REQUIREMENTS_LABEL"
					align = nobaseline
				}
				RequirementsList = {
					visible = "[Country.MakeScope.GetVariable('tv_research_target').IsSet]"
					textcontext = "[ShowTriggerConditions('tv_research_check_b_trigger', PlayerScope.Self)]"
					blockoverride "block_title" {
						block "block_title" {
							visible = no
						}
					}
					blockoverride "requirementslist_datamodel_is_empty" {
						visible = no
					}
				}

				# ── Subprocess C: Literacy Foundation ─────────────────────────────────────────────────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = {
						text = "TV_ACADEMY_SUBPROCESS_C_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_c').GetValue, '(CFixedPoint)0.0')]"
						text = "TV_RM_STATUS_NOT_STARTED"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_c').GetValue, '(CFixedPoint)1.0')]"
						raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText('tv_research_c_progress')]"
						align = nobaseline
					}
					text_single = {
						visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_c').GetValue, '(CFixedPoint)2.0')]"
						text = "TV_RM_STATUS_COMPLETE"
						align = nobaseline
					}
				}
				progressbar = {
					size = { 440 16 }
					using = progress_bar_blue_alt
					min = 0
					max = 100
					value = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_research_c_progress').GetValue]"
					visible = "[Country.MakeScope.GetVariable('tv_rm_subprocess_c').IsSet]"
				}
		}
				}
			}

			card_common = {
				maximumsize = { 500 -1 }
				visible = "[And(Country.MakeScope.GetVariable('tv_research_target').IsSet, EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_d_ready').GetValue, '(CFixedPoint)1.0'))]"

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/tabicons/advances.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_RM_PREPARATION_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 440
						text = "TV_RM_PREPARATION_COMPLETE_INFO"
						align = center
						margin = { 4 8 }
					}
				}
			}

			card_common = {
				maximumsize = { 500 -1 }
				visible = "[And(Country.MakeScope.GetVariable('tv_research_target').IsSet, EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_rm_subprocess_d_ready').GetValue, '(CFixedPoint)1.0'))]"

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/tabicons/advances.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_RM_CONCENTRATED_RESEARCH_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = fixed
						spacing = 4
						margin = { 4 6 }

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 4
							text_single = {
								text = "TV_ACADEMY_SUBPROCESS_D_LABEL"
								align = nobaseline
							}
							expand = {}
							text_single = {
								visible = "[Not(EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_research_phase').GetValue, '(CFixedPoint)2.0'))]"
								text = "TV_RM_STATUS_READY"
								align = nobaseline
							}
							text_single = {
								visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_research_phase').GetValue, '(CFixedPoint)2.0')]"
								raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText('tv_research_d_progress')]"
								align = nobaseline
							}
						}
						progressbar = {
							size = { 440 16 }
							using = progress_bar_blue_alt
							min = 0
							max = 100
							value = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_research_d_progress').GetValue]"
						}
					}
				}
			}

			# Action Buttons
			# ── Action Buttons ────────────────────────────────────────────────────────────────────────────────────

			# Request Research Target
			action_button_diamond = {
				size = { 470 30 }
				text = "TV_RM_REQUEST_TARGET_BTN"
				title = "TV_RM_REQUEST_TARGET_BTN"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = {
					action_name = "tv_request_research_target"
				}
			}

			# Abandon Target (visible when target is set)
			action_button_diamond = {
				size = { 470 30 }
				text = "TV_RM_ABANDON_TARGET_BTN"
				title = "TV_RM_ABANDON_TARGET_BTN"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = {
					action_name = "tv_abandon_research_target"
				}
			}

			# Begin Concentrated Research (visible when A+B+C complete and D not started)
			action_button_diamond = {
				size = { 470 30 }
				text = "TV_RM_START_D_BTN"
				title = "TV_RM_START_D_BTN"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = {
					action_name = "tv_start_concentrated_research"
				}
			}

			# Pause Concentrated Research (visible when D is in progress)
			action_button_diamond = {
				size = { 470 30 }
				text = "TV_RM_PAUSE_D_BTN"
				title = "TV_RM_PAUSE_D_BTN"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = {
					action_name = "tv_pause_concentrated_research"
				}
			}
			expand = {}
		}
	}

	# -- Medicine tab: enable the custom tab slot -------------------------------
	blockoverride "organization_custom_tab_visible" {
		visible = yes
	}
	blockoverride "organization_custom_tab_text" {
		text = "TV_MED_TAB"
	}
	blockoverride "organization_custom_tab_tooltip" {
		tooltip = "TV_MED_TAB_TOOLTIP"
	}

	blockoverride "organization_custom_content_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'custom' )]"
	}

	blockoverride "organization_custom_content" {
		vbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			spacing = 10

			vbox = {
				visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'custom' )]"
				layoutpolicy_horizontal = expanding
				spacing = 10

			card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/tabicons/advances.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_MED_TREATMENT_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

		# ── Patient character card (visible when treatment is active) ──────────
		io_character_card = {
			visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_med_target_char').IsSet]"
			datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_med_target_char').GetCharacter]"
			using = layoutpolicy_expanding
			blockoverride "name_highlight" {}
			blockoverride "character_entry_name_sort_by_highlight" {}
		}

		# ── Data block: patient + rates display ───────────────────────────────
		widget = {
			size = { 470 140 }
			datacontext = "[InternationalOrganizationsView.GetPlayer]"

			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4
				margin = { 4 6 }

				# ── Current patient ─────────────────────────────────────────────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = {
						text = "TV_MED_PATIENT_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						visible = "[Not(Country.MakeScope.GetVariable('tv_med_target_char').IsSet)]"
						text = "TV_MED_NO_PATIENT"
						align = nobaseline
					}
					text_single = {
						visible = "[Country.MakeScope.GetVariable('tv_med_target_char').IsSet]"
						datacontext = "[Country.MakeScope.GetVariable('tv_med_target_char').GetCharacter]"
						text = "[Character.GetShortNameWithNoTooltip]"
						align = nobaseline
					}
				}

				# ── Progress bar ────────────────────────────────────────────────────
				progressbar = {
					size = { 440 16 }
					using = progress_bar_green_alt
					min = 0
					max = 100
					value = "[Country.MakeScope.GetVariable('tv_med_progress').GetValue]"
					visible = "[Country.MakeScope.GetVariable('tv_med_target_char').IsSet]"
				}

				# ── Monthly progress gain (adm x 0.1%) ──────────────────────────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = {
						text = "TV_MED_MONTHLY_GAIN_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						raw_text = "[Country.MakeScope.GetVariable('tv_med_disp_adm').GetValue|0]x0.1%"
						align = nobaseline
					}
				}

				# ── Discovery event chance (dip x 0.2%) ─────────────────────────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = {
						text = "TV_MED_DISCOVERY_CHANCE_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						raw_text = "[Country.MakeScope.GetVariable('tv_med_disp_dip').GetValue|0]x0.2%"
						align = nobaseline
					}
				}

				# ── Accident chance (5% - mil x 0.05%) ──────────────────────────────
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = {
						text = "TV_MED_ACCIDENT_CHANCE_LABEL"
						align = nobaseline
					}
					expand = {}
					text_single = {
						raw_text = "5%-[Country.MakeScope.GetVariable('tv_med_disp_mil').GetValue|0]x0.05%"
						align = nobaseline
					}
				}
			}
		}

					}
				}
			}

			card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/tabicons/advances.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_MED_MEDITATION_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						text_multi = {
							visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_meditation_target_char').IsSet)]"
							size = { 470 -1 }
							autoresize = yes
							max_width = 460
							text = "TV_MED_MEDITATION_NO_TARGET_DESC"
						}

						io_character_card = {
							visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_meditation_target_char').IsSet]"
							datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_meditation_target_char').GetCharacter]"
							using = layoutpolicy_expanding
							blockoverride "name_highlight" {}
							blockoverride "character_entry_name_sort_by_highlight" {}
						}

						widget = {
							visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_meditation_target_char').IsSet]"
							size = { 470 88 }
							datacontext = "[InternationalOrganizationsView.GetPlayer]"

							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								margin = { 4 6 }

								progressbar = {
									size = { 440 16 }
									using = progress_bar_green_alt
									min = 0
									max = 100
									value = "[Country.MakeScope.GetVariable('tv_meditation_progress').GetValue]"
								}

								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4
									text_single = {
										text = "TV_MED_MEDITATION_PROGRESS_LABEL"
										align = nobaseline
									}
									expand = {}
									text_single = {
										raw_text = "[Country.MakeScope.GetVariable('tv_meditation_progress').GetValue|0]%"
										align = nobaseline
									}
								}

								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4
									text_single = {
										text = "TV_MED_MONTHLY_GAIN_LABEL"
										align = nobaseline
									}
									expand = {}
									text_single = {
										raw_text = "[Country.MakeScope.GetVariable('tv_med_disp_adm').GetValue|0]x0.1%"
										align = nobaseline
									}
								}

								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4
									text_single = {
										text = "TV_MED_MEDITATION_EVENT_CHANCE_LABEL"
										align = nobaseline
									}
									expand = {}
									text_single = {
										raw_text = "10%"
										align = nobaseline
									}
								}
							}
						}
					}
				}
			}

			card_actions = {
				blockoverride "card_header_text" {
					text = "MAIN_ACTIONS"
				}
				blockoverride "card_header_icon" {
					block "io_main_actions_icon" {
						texture = "gfx/interface/icons/flat_icons/tabicons/advances.dds"
					}
				}

				blockoverride "actions_override" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 2

						# Treat Character button
						action_button_diamond = {
							size = { 470 30 }
							text = "tv_treat_character"
							title = "tv_treat_character"
							actor = "[InternationalOrganizationsView.GetPlayer]"
							left_action = {
								action_name = "tv_treat_character"
							}
						}

						# Start Meditation button
						action_button_diamond = {
							size = { 470 30 }
							text = "tv_start_meditation"
							title = "tv_start_meditation"
							actor = "[InternationalOrganizationsView.GetPlayer]"
							left_action = {
								action_name = "tv_start_meditation"
							}
						}

						# Stop Meditation button
						action_button_diamond = {
							size = { 470 30 }
							text = "tv_stop_meditation"
							title = "tv_stop_meditation"
							actor = "[InternationalOrganizationsView.GetPlayer]"
							left_action = {
								action_name = "tv_stop_meditation"
							}
						}
					}
				}
			}
			}
		}
	}
}
