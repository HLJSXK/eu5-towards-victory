			parentanchor = hcenter
			using = layoutpolicy_expanding
		}

		# ── Data block: patient + rates display ───────────────────────────────
		widget = {
			size = { 470 140 }
			datacontext = "[InternationalOrganizationsView.GetPlayer]"

			vbox = {
