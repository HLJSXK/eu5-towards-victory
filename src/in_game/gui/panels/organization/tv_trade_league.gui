											text_single = { size = { 58 24 } raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_trade_monopoly_level_pct_horses').GetValue|0]%" align = nobaseline|right }
											text_single = { size = { 250 24 } text = "TV_TRADE_LEAGUE_NOT_MONOPOLIZED" align = nobaseline|left }
