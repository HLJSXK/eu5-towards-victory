										hbox = {
											visible = "[GreaterThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_trade_monopoly_horses').GetValue, '(CFixedPoint)1.0')]"
											size = { 340 24 }
