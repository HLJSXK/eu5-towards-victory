									piechart = {
										size = { 54 54 }
										using = piechart_angles
										icon = { texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds" size = { 97% 97% } parentanchor = center color = { 0.45 0.59 0.67 1 } alpha = 0.3 }
										pieslice = { texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds" value = "[FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_trade_monopoly_level_pct_horses').GetValue)]" color = { 0.85 0.65 0.22 1 } alpha = 0.8 }
										pieslice = { texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds" value = "[Subtract_float('(float)100.0', FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_trade_monopoly_level_pct_horses').GetValue))]" color = { 1 1 1 0 } }
										using = bg_circle_piechart
									}
