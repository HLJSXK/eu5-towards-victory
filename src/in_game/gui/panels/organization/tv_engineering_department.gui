# Towards Victory - Engineering Department IO Panel
# Overview tab: status, conception, and debate.
# Header: Great Engineer appointment, replacement, and dismissal.
# Resolutions tab: survey, organization, and logistics.
# Custom tab: construction and ceremony.

types EngineeringDepartmentTypes
{
	type tv_engineering_department_card_common = hbox {
		layoutpolicy_horizontal = expanding
		vbox = {
			layoutpolicy_horizontal = expanding

			block "card_bg" {
				using = bg_paper_card_situations
			}

			widget = {
				layoutpolicy_horizontal = expanding
				block "header_size" {
					size = {-1 50}
				}

				block "header_decor_templates" {
					using = bg_geodiplo_situation_header_secondary
				}

				block "common_header_back_decor" {}
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					block "common_header_margin" {}
					block "common_header_extra_left" { expand = {} }
					block "common_header" {
						block "common_header_icon" {
							icon = {
								size = { 30 30 }
								block "common_header_icon_texture" {
									texture = "gfx/interface/icons/religious_doctrines/catholic/religious_actions.dds"
								}
								texture_density = 2
								using = overlay_color_light_blue
								alpha = 1
							}
						}
						block "common_header_text_full" {
							text_single = {
								block "common_header_text" {
									raw_text = "Card title header"
								}
							}
						}
						block "common_header_text_expand" {}
					}
					block "common_header_extra_right" { expand = {} }
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4
				block "card_common_bottom_margin" {
					margin = {15 10}
				}
				block "common_bottom_content" {
					icon = {
						size = { 30 30 }
						texture = "gfx/interface/icons/religious_doctrines/catholic/religious_actions.dds"
						texture_density = 2
					}
					text_single = {
						raw_text = "Card content text"
					}
					expand = {}
				}
			}

			expand = {}
		}
	}
}

organization_panel = {

	state = {
		name = _show
		on_start = "[PdxGuiWidget.PushMapModeOverride('tv_wonder')]"
	}

	state = {
		name = _hide
		on_start = "[PdxGuiWidget.PopMapModeOverride]"
	}

	blockoverride "organization_overview_tab_visible" {}

	blockoverride "organization_panel_overview_visible" {
		visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
	}

	blockoverride "organization_members_tab_visible" {
		visible = no
	}

	blockoverride "organization_members_tab_down" {
		down = no
	}

	blockoverride "organization_panel_members_visible" {
		visible = no
	}

	blockoverride "scroll_overview_empty_visible" { visible = no }

	blockoverride "country_header_character_visible" {
		visible = yes
	}
	blockoverride "country_header_religion" {}
	blockoverride "extra_titles" {}
	blockoverride "organization_panel_extra_item" {
		widget = {
			size = { 260 120 }
			parentanchor = top|right
			widgetanchor = top|right
			position = { -12 6 }
			allow_outside = yes

			vbox = {
				layoutpolicy_horizontal = fixed
				layoutpolicy_vertical = fixed
				minimumsize = { 260 120 }
				maximumsize = { 260 120 }
				using = bg_paper_card_situations

				widget = {
					layoutpolicy_horizontal = expanding
					size = {-1 42}
					using = bg_geodiplo_situation_header_secondary

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4
						expand = {}
						icon = {
							size = { 30 30 }
							texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
							texture_density = 2
							using = overlay_color_light_blue
							alpha = 1
						}
						text_single = {
							text = "TV_ENGINEERING_CURRENT_GUIDANCE_CARD_TITLE"
						}
						expand = {}
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					margin = { 10 4 }
					vbox = {
						size = { 236 72 }
						layoutpolicy_horizontal = fixed
						layoutpolicy_vertical = fixed
						ignoreinvisible = yes
						spacing = 4

						text_single = {
							visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet)]"
							text = "TV_ENGINEERING_HEADER_NEXT_NO_ENGINEER"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet)]"
							text = "TV_ENGINEERING_HEADER_NEXT_CONCEPT"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And(And(And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, LessThan_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0'), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').IsSet)), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_slot_1').IsSet)), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet))]"
							text = "TV_ENGINEERING_HEADER_NEXT_NO_PROPOSAL"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And(And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, LessThan_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0'), Or(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_slot_1').IsSet)), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet))]"
							text = "TV_ENGINEERING_HEADER_NEXT_PROPOSAL"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet, EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0'))]"
							text = "TV_ENGINEERING_HEADER_NEXT_DEBATE"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And(And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_complete').IsSet)), And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet, GreaterThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)2.0'), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet)))]"
							text = "TV_ENGINEERING_HEADER_NEXT_SURVEY"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_complete').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet))]"
							text = "TV_ENGINEERING_HEADER_NEXT_CONFIRM_SITE"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_construction_complete').IsSet), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_finalized').IsSet)))]"
							text = "TV_ENGINEERING_HEADER_NEXT_BUILD"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_construction_complete').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_finalized').IsSet), InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet))]"
							text = "TV_ENGINEERING_HEADER_NEXT_CEREMONY"
							fontsize = 14
							align = nobaseline|left
						}
						text_single = {
							visible = "[And(And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_finalized').IsSet), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet))]"
							text = "TV_ENGINEERING_HEADER_NEXT_FINALIZED"
							fontsize = 14
							align = nobaseline|left
						}

						text_multi = {
							visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet)]"
							max_width = 236
							autoresize = yes
							text = "TV_ENGINEERING_HEADER_GUIDANCE_NO_ENGINEER"
							align = nobaseline|left
						}
						text_multi = {
							visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet)]"
							max_width = 236
							autoresize = yes
							text = "TV_ENGINEERING_HEADER_GUIDANCE_CONCEPT"
							align = nobaseline|left
						}
						text_multi = {
							visible = "[And(And(And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, LessThan_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0'), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').IsSet)), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_slot_1').IsSet)), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet))]"
							max_width = 236
							autoresize = yes
							text = "TV_ENGINEERING_HEADER_GUIDANCE_NO_PROPOSAL"
							align = nobaseline|left
						}
						text_multi = {
							visible = "[And(And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, LessThan_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0'), Or(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_slot_1').IsSet)), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet))]"
							max_width = 236
							autoresize = yes
							text = "TV_ENGINEERING_HEADER_GUIDANCE_PROPOSAL"
							align = nobaseline|left
						}
						text_multi = {
							visible = "[And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet, EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0'))]"
							max_width = 236
							autoresize = yes
							text = "TV_ENGINEERING_HEADER_GUIDANCE_DEBATE"
							align = nobaseline|left
						}
						text_multi = {
							visible = "[And(And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_complete').IsSet)), And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet, GreaterThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)2.0'), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet)))]"
							max_width = 236
							autoresize = yes
							text = "TV_ENGINEERING_HEADER_GUIDANCE_SURVEY"
							align = nobaseline|left
						}
						text_multi = {
							visible = "[And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_complete').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet))]"
							max_width = 236
							autoresize = yes
							text = "TV_ENGINEERING_HEADER_GUIDANCE_CONFIRM_SITE"
							align = nobaseline|left
						}
						text_multi = {
							visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_construction_complete').IsSet), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_finalized').IsSet)))]"
							max_width = 236
							autoresize = yes
							text = "TV_ENGINEERING_HEADER_GUIDANCE_BUILD"
							align = nobaseline|left
						}
						text_multi = {
							visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_construction_complete').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_finalized').IsSet), InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet))]"
							max_width = 236
							autoresize = yes
							text = "TV_ENGINEERING_HEADER_GUIDANCE_CEREMONY"
