# Towards Victory - Engineering Department IO Panel
# Overview tab: status, conception, and debate.
# Header: Great Engineer appointment, replacement, and dismissal.
# Resolutions tab: survey, organization, and logistics.
# Custom tab: construction and ceremony.

organization_panel = {

	blockoverride "organization_overview_tab_visible" {}

	blockoverride "organization_panel_overview_visible" {
		visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
	}

	blockoverride "organization_members_tab_visible" {
		visible = no
	}

	blockoverride "organization_members_tab_down" {
		down = no
	}

	blockoverride "organization_panel_members_visible" {
		visible = no
	}

	blockoverride "scroll_overview_empty_visible" { visible = no }

	blockoverride "country_header_character_visible" {
		visible = yes
	}
	blockoverride "country_header_religion" {}
	blockoverride "extra_titles" {}
	blockoverride "country_header_extra" {
		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 10 10 }
			spacing = 8

			vbox = {
				visible = "[And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_active_part').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_construction_complete').IsSet))]"
				size = { 360 46 }
				spacing = 3

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					text_single = { text = "TV_ENGINEERING_HEADER_CONSTRUCTION_PROGRESS" align = nobaseline|left }
					text_single = { raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText('tv_wonder_construction_progress')]" align = nobaseline|left }
					expand = {}
					text_single = {
						datacontext = "[InternationalOrganizationsView.GetPlayer]"
						text = "TV_ENGINEERING_CONSTRUCTION_PERCENT_TEXT"
						align = nobaseline|right
					}
				}
				progressbar = {
					layoutpolicy_horizontal = expanding
					size = { -1 12 }
					using = progress_bar_goldish
					min = 0
					max = 100
					value = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_construction_progress_pct').GetValue]"
					tooltip = "TV_ENGINEERING_CONSTRUCTION_PROGRESS_TT"
				}
			}

			expand = {}

			card_common = {
				layoutpolicy_horizontal = fixed
				layoutpolicy_vertical = fixed
				minimumsize = { 330 82 }
				maximumsize = { 330 82 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ENGINEERING_CURRENT_GUIDANCE_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					widget = {
						size = { 306 42 }
						vbox = {
							margin = { 8 4 }
							layoutpolicy_horizontal = expanding
							ignoreinvisible = yes

							text_multi = {
								visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet)]"
								max_width = 290
								autoresize = yes
								text = "TV_ENGINEERING_HEADER_GUIDANCE_NO_ENGINEER"
								align = nobaseline|left
							}
							text_multi = {
								visible = "[And(And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, LessThan_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0'), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').IsSet)), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_slot_1').IsSet))]"
								max_width = 290
								autoresize = yes
								text = "TV_ENGINEERING_HEADER_GUIDANCE_NO_PROPOSAL"
								align = nobaseline|left
							}
							text_multi = {
								visible = "[And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, LessThan_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0'), Or(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_slot_1').IsSet))]"
								max_width = 290
								autoresize = yes
								text = "TV_ENGINEERING_HEADER_GUIDANCE_PROPOSAL"
								align = nobaseline|left
							}
							text_multi = {
								visible = "[And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet, EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0'))]"
								max_width = 290
								autoresize = yes
								text = "TV_ENGINEERING_HEADER_GUIDANCE_DEBATE"
								align = nobaseline|left
							}
							text_multi = {
								visible = "[And(And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_complete').IsSet)), And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet, GreaterThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)2.0'), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet)))]"
								max_width = 290
								autoresize = yes
								text = "TV_ENGINEERING_HEADER_GUIDANCE_SURVEY"
								align = nobaseline|left
							}
							text_multi = {
								visible = "[And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_complete').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet))]"
								max_width = 290
								autoresize = yes
								text = "TV_ENGINEERING_HEADER_GUIDANCE_CONFIRM_SITE"
								align = nobaseline|left
							}
							text_multi = {
								visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_construction_complete').IsSet), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_finalized').IsSet)))]"
								max_width = 290
								autoresize = yes
								text = "TV_ENGINEERING_HEADER_GUIDANCE_BUILD"
								align = nobaseline|left
							}
							text_multi = {
								visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_construction_complete').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_finalized').IsSet), InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet))]"
								max_width = 290
								autoresize = yes
								text = "TV_ENGINEERING_HEADER_GUIDANCE_CEREMONY"
								align = nobaseline|left
							}
							text_multi = {
								visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_finalized').IsSet)]"
								max_width = 290
								autoresize = yes
								text = "TV_ENGINEERING_HEADER_GUIDANCE_FINALIZED"
								align = nobaseline|left
							}
						}
					}
				}
			}
		}
	}
	blockoverride "country_header_names_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
	}
	blockoverride "country_header_character_name" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').GetCharacter]"
		margin = { 2 0 }
		character_label_name = {
			margin_left = 0
			margin_right = 10
			blockoverride "character_name_text" {
				raw_text = "[Character.GetNameToFit('(int32)40', '(bool)yes')]"
			}
		}
	}
	blockoverride "character_widget" {
		widget = {
			position = { 0 -30 }
			allow_outside = yes
			block "portrait_io_widget" {
				size = { 250 200 }
			}

			block "character_portrait_anchor" {
				parentanchor = bottom
			}

			portrait_standard_full_body_center_button = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
				block "character_right_visible" {
					visible = yes
				}
				parentanchor = bottom

				size = { 250 200 }
				datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').GetCharacter]"
			}

			action_button = {
				visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet)]"
				size = { 250 200 }
				parentanchor = center
				widgetanchor = center
				position = { 0 0 }
				alpha = 0
				alwaystransparent = no
				using = action_button_common_template
				title = "tv_appoint_engineering_leader"
				description = "tv_appoint_engineering_leader_desc"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = { action_name = "tv_appoint_engineering_leader" }
			}

			action_button = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
				size = { 78 26 }
				parentanchor = top|right
				widgetanchor = top|right
				position = { 0 20 }
				using = button_regular_texture_alt_yellow
				using = action_button_common_template
				using = button_common_textobj_template
				fontsize = 13
				title = "tv_change_engineering_leader"
				description = "tv_change_engineering_leader_desc"
				text = "TV_ENGINEERING_CHANGE_LEADER_SHORT"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = { action_name = "tv_change_engineering_leader" }
			}
			action_button = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
				size = { 78 26 }
				parentanchor = top|right
				widgetanchor = top|right
				position = { 0 49 }
				using = button_regular_texture_alt_red
				using = action_button_common_template
				using = button_common_textobj_template
				fontsize = 13
				title = "tv_remove_engineering_leader"
				description = "tv_remove_engineering_leader_desc"
				text = "TV_ENGINEERING_REMOVE_LEADER_SHORT"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = { action_name = "tv_remove_engineering_leader" }
			}
		}
	}

	blockoverride "io_main_actions_icon" {
		texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
	}

	blockoverride "organization_overview_list_custom_top_extra" {
		vbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			ignoreinvisible = yes
			spacing = 10

			widget = {
				visible = "[Or(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').IsSet)]"
				layoutpolicy_horizontal = expanding
				size = { -1 333 }
				maximumsize = { 500 333 }
				alwaystransparent = yes




