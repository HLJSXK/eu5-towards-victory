							set_parent_size_to_minimum = yes
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = shrinking
							ignoreinvisible = yes
							spacing = 4
							margin = { 4 4 }

			# BEGIN GENERATED TV_WONDER_MECHANICS_SUITABILITY_KNOWLEDGE
