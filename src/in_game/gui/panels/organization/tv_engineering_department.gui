										text_single = { text = "TV_ENGINEERING_DEMAND_BURGHERS" multiline = yes align = nobaseline|left }
										text_single = { text = "TV_ENGINEERING_SOLUTION_BURGHERS" multiline = yes align = nobaseline|left }
