	# -- Construction tab: organization, logistics, and build --------------------
	blockoverride "organization_resolutions_tab_visible" {
		visible = yes
	}
	blockoverride "organization_resolutions_tab_text" {
		text = "TV_ENGINEERING_CONSTRUCTION_TAB"
	}
	blockoverride "organization_resolutions_tooltip" {
		tooltip = "TV_ENGINEERING_CONSTRUCTION_TAB_TOOLTIP"
	}

	blockoverride "organization_resolutions_content" {
		margin = { 0 0 }

		vbox = {
			margin = { 10 10 }
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = fixed
			ignoreinvisible = yes
			spacing = 10

			card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ENGINEERING_ORG_LOG_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					widget = {
						size = { 470 222 }

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 7
							margin = { 4 6 }

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								button_regular = { size = { 150 30 } enabled = no text = "TV_ENGINEERING_BUILD_LABOR_CAMP_BUTTON" tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT" }
								button_regular = { size = { 150 30 } enabled = no text = "TV_ENGINEERING_BUILD_DEPOT_BUTTON" tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT" }
								button_regular = { size = { 150 30 } enabled = no text = "TV_ENGINEERING_BUILD_DISPATCH_BUTTON" tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT" }
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = { text = "TV_ENGINEERING_LABOR_PROGRESS_LABEL" align = nobaseline }
								expand = {}
								text_single = { raw_text = "0/30000" align = nobaseline }
							}
							progressbar = { size = { 462 16 } using = progress_bar_blue_alt min = 0 max = 30000 value = 0 tooltip = "TV_ENGINEERING_LABOR_PROGRESS_TT" }
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = { size = { 72 16 } raw_text = "I" align = nobaseline|center }
								text_single = { size = { 72 16 } raw_text = "II" align = nobaseline|center }
								text_single = { size = { 72 16 } raw_text = "III" align = nobaseline|center }
								text_single = { size = { 72 16 } raw_text = "IV" align = nobaseline|center }
								text_single = { size = { 72 16 } raw_text = "V" align = nobaseline|center }
								text_single = { size = { 72 16 } raw_text = "VI" align = nobaseline|center }
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = { text = "TV_ENGINEERING_MATERIALS_LABEL" align = nobaseline }
								expand = {}
								text_single = {
									raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText('tv_wonder_materials_stockpile')]"
									align = nobaseline
								}
							}
							progressbar = {
								size = { 462 16 }
								using = progress_bar_goldish
								min = 0
								max = 300000
								value = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_wonder_materials_stockpile').GetValue]"
								tooltip = "TV_ENGINEERING_MATERIALS_PROGRESS_TT"
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = { size = { 72 16 } raw_text = "60k" align = nobaseline|center }
								text_single = { size = { 72 16 } raw_text = "120k" align = nobaseline|center }
								text_single = { size = { 72 16 } raw_text = "180k" align = nobaseline|center }
								text_single = { size = { 72 16 } raw_text = "240k" align = nobaseline|center }
								text_single = { size = { 72 16 } raw_text = "300k" align = nobaseline|center }
								text_single = { size = { 72 16 } raw_text = "cap" align = nobaseline|center }
							}

							text_single = {
								layoutpolicy_horizontal = expanding
								text = "TV_ENGINEERING_ORG_LOG_HELP_TEXT"
								multiline = yes
								align = nobaseline|left
							}
						}
					}
				}
			}
			card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ENGINEERING_CONSTRUCTION_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					widget = {
						size = { 470 254 }

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							margin = { 4 6 }

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 5
								button_regular = { size = { 48 28 } enabled = no text = "TV_ENGINEERING_BUILD_SHORT_BUTTON" tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT" }
								text_single = { size = { 112 28 } text = "TV_ENGINEERING_CONSTRUCTION_PART_FOUNDATION" align = nobaseline|left }
								text_single = { size = { 44 28 } raw_text = "1" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "2" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "3" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "4" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "5" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "6" align = nobaseline|center }
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 5
								button_regular = { size = { 48 28 } enabled = no text = "TV_ENGINEERING_BUILD_SHORT_BUTTON" tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT" }
								text_single = { size = { 112 28 } text = "TV_ENGINEERING_CONSTRUCTION_PART_BODY" align = nobaseline|left }
								text_single = { size = { 44 28 } raw_text = "1" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "2" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "3" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "4" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "5" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "6" align = nobaseline|center }
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 5
								button_regular = { size = { 48 28 } enabled = no text = "TV_ENGINEERING_BUILD_SHORT_BUTTON" tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT" }
								text_single = { size = { 112 28 } text = "TV_ENGINEERING_CONSTRUCTION_PART_FUNCTION" align = nobaseline|left }
								text_single = { size = { 44 28 } raw_text = "1" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "2" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "3" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "4" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "5" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "6" align = nobaseline|center }
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 5
								button_regular = { size = { 48 28 } enabled = no text = "TV_ENGINEERING_BUILD_SHORT_BUTTON" tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT" }
								text_single = { size = { 112 28 } text = "TV_ENGINEERING_CONSTRUCTION_PART_DECORATION" align = nobaseline|left }
								text_single = { size = { 44 28 } raw_text = "1" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "2" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "3" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "4" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "5" align = nobaseline|center }
								text_single = { size = { 44 28 } raw_text = "6" align = nobaseline|center }
							}

							progressbar = { size = { 462 16 } using = progress_bar_goldish min = 0 max = 300000 value = 0 tooltip = "TV_ENGINEERING_CONSTRUCTION_PROGRESS_TT" }
							text_single = {
								layoutpolicy_horizontal = expanding
								text = "TV_ENGINEERING_CONSTRUCTION_INFO_TEXT"
								multiline = yes
								align = nobaseline|left
							}
							button_regular = {
								size = { 462 30 }
								enabled = no
								text = "TV_ENGINEERING_FINISH_CONSTRUCTION_BUTTON"
								tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT"
							}
						}
					}
				}
			}
		}

		expand = {}
	}

	# -- Ceremony tab -----------------------------------------------------------
	blockoverride "organization_custom_tab_visible" {
		visible = yes
	}
	blockoverride "organization_custom_tab_text" {
		text = "TV_ENGINEERING_CEREMONY_TAB"
	}
	blockoverride "organization_custom_tab_tooltip" {
		tooltip = "TV_ENGINEERING_CEREMONY_TAB_TOOLTIP"
	}

	blockoverride "organization_custom_content_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'custom' )]"
	}

	blockoverride "organization_custom_content" {
		margin_top = -5
		spacing = 0
		layoutpolicy_vertical = expanding

		scrollarea = {
			using = layoutpolicy_expanding
			scrollbarpolicy_horizontal = always_off

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}

			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					ignoreinvisible = yes
					spacing = 10
					margin = { 10 2 }

					card_common = {
						maximumsize = { 500 -1 }

						blockoverride "common_header_icon_texture" {
							texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
						}

						blockoverride "common_header_text" {
							text = "TV_ENGINEERING_CEREMONY_CARD_TITLE"
						}

						blockoverride "common_bottom_content" {
							widget = {
								size = { 470 296 }

								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 6
									margin = { 4 6 }

									text_single = {
										layoutpolicy_horizontal = expanding
										text = "TV_ENGINEERING_CEREMONY_HELP_TEXT"
										multiline = yes
										align = nobaseline|left
									}

									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 4
										button_regular = { size = { 150 30 } enabled = no text = "TV_ENGINEERING_CEREMONY_STYLE_1_BUTTON" tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT" }
										button_regular = { size = { 150 30 } enabled = no text = "TV_ENGINEERING_CEREMONY_STYLE_2_BUTTON" tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT" }
										button_regular = { size = { 150 30 } enabled = no text = "TV_ENGINEERING_CEREMONY_STYLE_3_BUTTON" tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT" }
									}

									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 6

										widget = {
											size = { 150 216 }
											using = bg_text_mask_container_dark_blue
											vbox = {
												margin = { 4 4 }
												spacing = 5
												text_single = { text = "TV_ENGINEERING_WONDER_SACRED_MOUNTAIN" align = nobaseline|center }
												text_single = { text = "TV_ENGINEERING_RITUAL_SACRIFICE" multiline = yes align = nobaseline|left }
												text_single = { text = "TV_ENGINEERING_RITUAL_MEDITATION" multiline = yes align = nobaseline|left }
												text_single = { text = "TV_ENGINEERING_RITUAL_THEOCRACY" multiline = yes align = nobaseline|left }
											}
										}
										widget = {
											size = { 150 216 }
											using = bg_text_mask_container_dark_blue
											vbox = {
												margin = { 4 4 }
												spacing = 5
												text_single = { text = "TV_ENGINEERING_WONDER_TRIUMPHAL_AXIS" align = nobaseline|center }
												text_single = { text = "TV_ENGINEERING_RITUAL_EMISSARIES" multiline = yes align = nobaseline|left }
												text_single = { text = "TV_ENGINEERING_RITUAL_TRIUMPH" multiline = yes align = nobaseline|left }
												text_single = { text = "TV_ENGINEERING_RITUAL_CIVIC" multiline = yes align = nobaseline|left }
											}
										}
										widget = {
											size = { 150 216 }
											using = bg_text_mask_container_dark_blue
											vbox = {
												margin = { 4 4 }
												spacing = 5
												text_single = { text = "TV_ENGINEERING_WONDER_GREAT_PORT" align = nobaseline|center }
												text_single = { text = "TV_ENGINEERING_RITUAL_AUCTION" multiline = yes align = nobaseline|left }
												text_single = { text = "TV_ENGINEERING_RITUAL_FLEET" multiline = yes align = nobaseline|left }
												text_single = { text = "TV_ENGINEERING_RITUAL_FREE_TRADE" multiline = yes align = nobaseline|left }
											}
										}
									}

									button_regular = {
										size = { 462 30 }
										enabled = no
										text = "TV_ENGINEERING_COMPLETE_CEREMONY_BUTTON"
										tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
