	# -- Survey and logistics tab ------------------------------------------------
	blockoverride "organization_resolutions_tab_visible" {
		visible = yes
	}
	blockoverride "organization_resolutions_tab_text" {
		text = "TV_ENGINEERING_CONSTRUCTION_TAB"
	}
	blockoverride "organization_resolutions_tooltip" {
		tooltip = "TV_ENGINEERING_CONSTRUCTION_TAB_TOOLTIP"
	}

	blockoverride "organization_resolutions_content" {
		margin = { 0 0 }
		layoutpolicy_vertical = expanding

		scrollarea = {
			using = layoutpolicy_expanding
			scrollbarpolicy_horizontal = always_off

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}

			scrollwidget = {
				vbox = {
					margin = { 10 10 }
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					ignoreinvisible = yes
					spacing = 10

					card_common = {
						visible = "[LessThan_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)2.0')]"
						layoutpolicy_vertical = fixed
						minimumsize = { 500 114 }
						maximumsize = { 500 114 }

						blockoverride "common_header_icon_texture" {
							texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
						}

						blockoverride "common_header_text" {
							text = "TV_ENGINEERING_SURVEY_CARD_TITLE"
						}

						blockoverride "common_bottom_content" {
							widget = {
								size = { 470 74 }
								text_multi = {
									margin = { 4 6 }
									max_width = 462
									autoresize = yes
									text = "TV_ENGINEERING_SURVEY_LOCKED_TEXT"
									align = nobaseline|left
								}
							}
						}
					}

			card_common = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)2.0')]"
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ENGINEERING_SURVEY_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					widget = {
						layoutpolicy_vertical = shrinking
						size = { 470 -1 }

						vbox = {
							set_parent_size_to_minimum = yes
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = shrinking
							ignoreinvisible = yes
							spacing = 4
							margin = { 4 4 }

			# BEGIN GENERATED TV_WONDER_MECHANICS_SUITABILITY_KNOWLEDGE
				widget = {
					visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet, EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').GetValue, '(CFixedPoint)1.0'))]"
					layoutpolicy_vertical = shrinking
					minimumsize = { 462 182 }
					using = bg_text_mask_container_dark_blue

					vbox = {
						set_parent_size_to_minimum = yes
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = shrinking
						margin = { 6 5 }
						ignoreinvisible = yes
						spacing = 3
						text_single = { text = "TV_ENGINEERING_SUITABILITY_KNOWLEDGE_TITLE" fontsize = 18 align = nobaseline|left }
						hbox = {
							layoutpolicy_horizontal = fixed
							size = { 444 -1 }
							spacing = 8
							ignoreinvisible = yes
							vbox = {
								layoutpolicy_horizontal = fixed
								layoutpolicy_vertical = expanding
								minimumsize = { 218 -1 }
								maximumsize = { 218 -1 }
								ignoreinvisible = yes
								spacing = 3
								text_single = { text = "TV_ENGINEERING_SUITABILITY_LOCATION_CONDITIONS_TITLE" max_width = 218 fontsize = 13 align = nobaseline|left }
								TooltipRequirementsList = {
									layoutpolicy_horizontal = fixed
									textcontext = "[ShowTriggerConditions('tv_wonder_player_visible_site_rules_sacred_mountain_trigger', PlayerScope.Self)]"
									maximumsize = { 218 -1 }
									blockoverride "tooltip_minimumsize" { minimumsize = { 218 -1 } }
									blockoverride "field_text_format" {
										fontsize = 13
									}
									blockoverride "row_size" {
										maximumsize = { -1 22 }
										minimumsize = { -1 22 }
									}
									blockoverride "block_title" {
										block "block_title" {
											visible = no
										}
									}
									blockoverride "requirementslist_datamodel_is_empty" {
										visible = no
									}
								}
							}
							vbox = {
								layoutpolicy_horizontal = fixed
								layoutpolicy_vertical = expanding
								minimumsize = { 218 -1 }
								maximumsize = { 218 -1 }
								ignoreinvisible = yes
								spacing = 3
								text_single = { text = "TV_ENGINEERING_SUITABILITY_CONDITIONS_TITLE" max_width = 218 fontsize = 13 align = nobaseline|left }
								hbox = {
									visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_suitability_revealed_sacred_mountain').IsSet, GreaterThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_suitability_revealed_sacred_mountain').GetValue, '(CFixedPoint)1.0'))]"
									layoutpolicy_horizontal = expanding
									spacing = 4
									text_single = { text = "TV_ENGINEERING_SUITABILITY_CONDITION_TOPOGRAPHY_MOUNTAINS" max_width = 168 fontsize = 13 align = nobaseline|left }
									expand = {}
									text_single = { visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_complete').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_suitability_actual_sacred_mountain_1').IsSet)]" raw_text = "#P [InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_suitability_actual_sacred_mountain_1').GetValue|+=]#!/#P +15#!" fontsize = 13 align = nobaseline|right }
									text_single = { visible = "[Not(And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_complete').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_suitability_actual_sacred_mountain_1').IsSet))]" raw_text = "#T ?#!/#P +15#!" fontsize = 13 align = nobaseline|right }
								}
								text_single = {
									visible = "[Not(And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_suitability_revealed_sacred_mountain').IsSet, GreaterThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_suitability_revealed_sacred_mountain').GetValue, '(CFixedPoint)1.0')))]"
									text = "TV_ENGINEERING_SUITABILITY_ROW_HIDDEN"
									max_width = 214
									fontsize = 13
									align = nobaseline|left
