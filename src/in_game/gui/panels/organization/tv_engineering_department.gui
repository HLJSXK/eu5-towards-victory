							}
							progressbar = {
								size = { 462 16 }
								using = progress_bar_blue_alt
								min = 0
								max = 30000
								value = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_laborers').GetValue]"
