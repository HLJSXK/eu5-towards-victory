							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								expand = {}
								button_regular = {
									size = { 92 28 }
									enabled = no
									text = "TV_ENGINEERING_ACCEPT_BUTTON"
									tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT"
								}
								button_regular = {
									size = { 92 28 }
									enabled = no
									text = "TV_ENGINEERING_REFUTE_BUTTON"
									tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT"
								}
								button_regular = {
									size = { 92 28 }
									enabled = no
									text = "TV_ENGINEERING_BRIBE_BUTTON"
									tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT"
								}
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = { text = "TV_ENGINEERING_DOMESTIC_SUPPORT_LABEL" align = nobaseline }
								expand = {}
								text_single = {
									raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText('tv_wonder_domestic_support')]"
									align = nobaseline
								}
							}
							progressbar = {
								size = { 462 16 }
								using = progress_bar_blue_alt
								min = 0
								max = 200
								value = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_wonder_domestic_support').GetValue]"
								tooltip = "TV_ENGINEERING_DOMESTIC_SUPPORT_BAR_TT"
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 5
								text_single = { size = { 225 18 } text = "TV_ENGINEERING_SUPPORT_BASE_LABEL" align = nobaseline|center }
								text_single = { size = { 225 18 } text = "TV_ENGINEERING_SUPPORT_RESERVE_LABEL" align = nobaseline|center }
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = { text = "TV_ENGINEERING_ESTATE_DEMANDS_LABEL" align = nobaseline|left }

								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 6
									text_single = { size = { 28 36 } raw_text = "@nobles!" align = nobaseline|center }
									vbox = {
										layoutpolicy_horizontal = expanding
										text_single = { text = "TV_ENGINEERING_DEMAND_NOBLES" multiline = yes align = nobaseline|left }
										text_single = { text = "TV_ENGINEERING_SOLUTION_NOBLES" multiline = yes align = nobaseline|left }
