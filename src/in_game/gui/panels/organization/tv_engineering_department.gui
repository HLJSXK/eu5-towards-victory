# Towards Victory - Engineering Department IO Panel
# Overview tab: status, conception, and debate.
# Header: Great Engineer appointment, replacement, and dismissal.
# Resolutions tab: survey, organization, and logistics.
# Custom tab: construction and ceremony.

organization_panel = {

	blockoverride "organization_overview_tab_visible" {}

	blockoverride "organization_panel_overview_visible" {
		visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
	}

	blockoverride "organization_members_tab_visible" {
		visible = no
	}

	blockoverride "organization_members_tab_down" {
		down = no
	}

	blockoverride "organization_panel_members_visible" {
		visible = no
	}

	blockoverride "scroll_overview_empty_visible" { visible = no }

	blockoverride "country_header_character_visible" {
		visible = yes
	}
	blockoverride "country_header_religion" {}
	blockoverride "extra_titles" {}
	blockoverride "country_header_names_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
	}
	blockoverride "country_header_character_name" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').GetCharacter]"
		margin = { 2 0 }
		character_label_name = {
			margin_left = 0
			margin_right = 10
			blockoverride "character_name_text" {
				raw_text = "[Character.GetNameToFit('(int32)40', '(bool)yes')]"
			}
		}
	}
	blockoverride "character_widget" {
		widget = {
			position = { 0 -30 }
			allow_outside = yes
			block "portrait_io_widget" {
				size = { 250 200 }
			}

			block "character_portrait_anchor" {
				parentanchor = bottom
			}

			portrait_standard_full_body_center_button = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
				block "character_right_visible" {
					visible = yes
				}
				parentanchor = bottom

				size = { 250 200 }
				datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').GetCharacter]"
			}

			action_button = {
				visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet)]"
				size = { 250 200 }
				parentanchor = center
				widgetanchor = center
				position = { 0 0 }
				alpha = 0
				alwaystransparent = no
				using = action_button_common_template
				title = "tv_appoint_engineering_leader"
				description = "tv_appoint_engineering_leader_desc"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = { action_name = "tv_appoint_engineering_leader" }
			}

			action_button = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
				size = { 78 26 }
				parentanchor = top|right
				widgetanchor = top|right
				position = { 0 20 }
				using = button_regular_texture_alt_yellow
				using = action_button_common_template
				using = button_common_textobj_template
				fontsize = 13
				title = "tv_change_engineering_leader"
				description = "tv_change_engineering_leader_desc"
				text = "TV_ENGINEERING_CHANGE_LEADER_SHORT"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = { action_name = "tv_change_engineering_leader" }
			}
			action_button = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
				size = { 78 26 }
				parentanchor = top|right
				widgetanchor = top|right
				position = { 0 49 }
				using = button_regular_texture_alt_red
				using = action_button_common_template
				using = button_common_textobj_template
				fontsize = 13
				title = "tv_remove_engineering_leader"
				description = "tv_remove_engineering_leader_desc"
				text = "TV_ENGINEERING_REMOVE_LEADER_SHORT"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = { action_name = "tv_remove_engineering_leader" }
			}
		}
	}

	blockoverride "io_main_actions_icon" {
		texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
	}

	blockoverride "organization_overview_list_custom_top_extra" {
		vbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			ignoreinvisible = yes
			spacing = 10

			card_common = {
				visible = no
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ENGINEERING_SURVEY_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					widget = {
						size = { 470 232 }

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8
							margin = { 4 6 }

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = { text = "TV_ENGINEERING_SURVEY_SITE_LABEL" align = nobaseline }
								expand = {}
								text_single = {
									visible = "[And(Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_site').IsSet), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet))]"
									text = "TV_ENGINEERING_NO_SURVEY_SITE"
									align = nobaseline
								}
								text_single = {
									visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_site').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet))]"
									raw_text = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_site').GetLocation.GetNameWithNoTooltip]"
									align = nobaseline
								}
								text_single = {
									visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet]"
									raw_text = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').GetLocation.GetNameWithNoTooltip]"
									align = nobaseline
								}
							}
							action_button_diamond = {
								visible = "[And(Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_complete').IsSet), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet))]"
								size = { 462 30 }
								text = "TV_ENGINEERING_SELECT_SURVEY_SITE_BUTTON"
								title = "tv_wonder_start_survey"
								description = "tv_wonder_start_survey_desc"
								actor = "[InternationalOrganizationsView.GetPlayer]"
								left_action = {
									action_name = "tv_wonder_start_survey"
								}
							}
							action_button_diamond = {
								visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_survey_complete').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_site').IsSet))]"
								size = { 462 30 }
								text = "TV_ENGINEERING_CONFIRM_SURVEY_SITE_BUTTON"
								title = "tv_wonder_select_construction_site"
								description = "tv_wonder_select_construction_site_desc"
								actor = "[InternationalOrganizationsView.GetPlayer]"
								left_action = {
									action_name = "tv_wonder_select_construction_site"
								}
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = { text = "TV_ENGINEERING_SURVEY_PROGRESS_LABEL" align = nobaseline }
								expand = {}
								text_single = {
									raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText('tv_wonder_survey_progress')]"
									align = nobaseline
								}
							}
							progressbar = {
								size = { 462 16 }
								using = progress_bar_green_alt
								min = 0
								max = 100
								value = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_wonder_survey_progress').GetValue]"
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 6
								widget = {
									size = { 148 96 }
									using = bg_text_mask_container_dark_blue
									vbox = {
										margin = { 4 4 }
										spacing = 3
										text_single = { text = "TV_ENGINEERING_SCALE_COMPETENCE_LABEL" align = nobaseline|center }
										hbox = {
											layoutpolicy_horizontal = expanding
											expand = {}
											widget = {
												size = { 44 44 }
												piechart = {
													size = { 44 44 }
													using = piechart_angles
													pieslice = { texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds" value = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_scale_competence').GetValue]" color = { 0.01 0.6 0.9 1 } }
													pieslice = { texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds" value = "[Subtract_CFixedPoint('(CFixedPoint)100.0', InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_scale_competence').GetValue)]" color = { 0.0 0.1 0.1 1 } }
												}
												icon = { parentanchor = center size = { 24 24 } texture = "gfx/interface/icons/flat_icons/building_panel/build.dds" texture_density = 2 }
											}
											expand = {}
										}
										text_single = { raw_text = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_scale_competence').GetValue|0]%" align = nobaseline|center }
									}
								}
								widget = {
									size = { 148 96 }
									using = bg_text_mask_container_dark_blue
									vbox = {
										margin = { 4 4 }
										spacing = 3
										text_single = { text = "TV_ENGINEERING_LOGISTICS_COMPETENCE_LABEL" align = nobaseline|center }
										hbox = {
											layoutpolicy_horizontal = expanding
											expand = {}
											widget = {
												size = { 44 44 }
												piechart = {
													size = { 44 44 }
													using = piechart_angles
													pieslice = { texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds" value = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_logistics_competence').GetValue]" color = { 0.01 0.6 0.9 1 } }
													pieslice = { texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds" value = "[Subtract_CFixedPoint('(CFixedPoint)100.0', InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_logistics_competence').GetValue)]" color = { 0.0 0.1 0.1 1 } }
												}
												icon = { parentanchor = center size = { 24 24 } texture = "gfx/interface/icons/resources/gold.dds" texture_density = 2 }
											}
											expand = {}
										}
										text_single = { raw_text = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_logistics_competence').GetValue|0]%" align = nobaseline|center }
									}
								}
								widget = {
									size = { 148 96 }
									using = bg_text_mask_container_dark_blue
									vbox = {
										margin = { 4 4 }
										spacing = 3
										text_single = { text = "TV_ENGINEERING_ORGANIZATION_COMPETENCE_LABEL" align = nobaseline|center }
										hbox = {
											layoutpolicy_horizontal = expanding
											expand = {}
											widget = {
												size = { 44 44 }
												piechart = {
													size = { 44 44 }
													using = piechart_angles
													pieslice = { texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds" value = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_organization_competence').GetValue]" color = { 0.01 0.6 0.9 1 } }
													pieslice = { texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds" value = "[Subtract_CFixedPoint('(CFixedPoint)100.0', InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_organization_competence').GetValue)]" color = { 0.0 0.1 0.1 1 } }
												}
												icon = { parentanchor = center size = { 24 24 } texture = "gfx/interface/icons/pops/laborers.dds" texture_density = 2 }
											}
											expand = {}
										}
										text_single = { raw_text = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_organization_competence').GetValue|0]%" align = nobaseline|center }
									}
								}
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = { layoutpolicy_horizontal = expanding raw_text = "@build_icon! [InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_scale_tier').GetValue|0]" tooltip = "TV_ENGINEERING_SURVEY_MAX_LEVEL_TT" align = nobaseline|center }
								text_single = { layoutpolicy_horizontal = expanding raw_text = "@gold! [InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_logistics_effect_percent').GetValue|0]%" tooltip = "TV_ENGINEERING_SURVEY_COST_TT" align = nobaseline|center }
								text_single = { layoutpolicy_horizontal = expanding raw_text = "@time! [InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_organization_effect_percent').GetValue|0]%" tooltip = "TV_ENGINEERING_SURVEY_SPEED_TT" align = nobaseline|center }
							}
						}
					}
				}
			}

			card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ENGINEERING_WONDER_PIPELINE_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					widget = {
						size = { 470 116 }

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							margin = { 4 6 }

							text_single = {
								layoutpolicy_horizontal = expanding
								text = "TV_ENGINEERING_WONDER_PIPELINE_DESC"
								multiline = yes
								align = nobaseline|left
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 3
								text_single = { size = { 86 28 } raw_text = "@build_icon! 1" tooltip = "TV_ENGINEERING_STAGE_CONCEPT" align = nobaseline|center }
								text_single = { size = { 86 28 } raw_text = "@location! 2" tooltip = "TV_ENGINEERING_STAGE_SURVEY" align = nobaseline|center }
								text_single = { size = { 92 28 } raw_text = "@laborers! 3" tooltip = "TV_ENGINEERING_STAGE_ORGANIZATION_LOGISTICS" align = nobaseline|center }
								text_single = { size = { 86 28 } raw_text = "@construction! 4" tooltip = "TV_ENGINEERING_STAGE_CONSTRUCTION" align = nobaseline|center }
								text_single = { size = { 86 28 } raw_text = "@prestige! 5" tooltip = "TV_ENGINEERING_STAGE_CEREMONY" align = nobaseline|center }
							}

							text_single = {
								layoutpolicy_horizontal = expanding
								text = "TV_ENGINEERING_UI_PLACEHOLDER_NOTE"
								multiline = yes
								align = nobaseline|left
							}
						}
					}
				}
			}

			card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ENGINEERING_CONCEPT_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					vbox = {
							layoutpolicy_horizontal = expanding
							ignoreinvisible = yes
							spacing = 6

							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = fixed
								size = { 470 116 }
								spacing = 10
								margin = { 8 8 }
								using = bg_paper_card
								using = bg_cabinet_card_frame

								widget = {
									size = { 76 92 }
									allow_outside = yes

									portrait_standard_head_button = {
										using = character_portrait_bg
										visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
										parentanchor = center
										widgetanchor = center
										size = { 58 72 }
										datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').GetCharacter]"

										icon = {
											block "character_frame_texture" {
												texture = "gfx/interface/component_decoration/character_frames/character_frame_1.dds"
											}
											texture_density = 2
											size = { 100% 100% }
										}
									}
								}

								widget = {
									size = { 368 92 }
									using = bg_text_mask_container_dark_blue
									vbox = {
										margin = { 8 8 }
										layoutpolicy_horizontal = expanding
										ignoreinvisible = yes
										text_multi = {
											visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet)]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_NEEDS_ENGINEER_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').IsSet), LessThan_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0'))]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_NONE_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').GetValue, '(CFixedPoint)1.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_SACRED_MOUNTAIN_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').GetValue, '(CFixedPoint)2.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_TRIUMPHAL_AXIS_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').GetValue, '(CFixedPoint)3.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_GREAT_PORT_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').GetValue, '(CFixedPoint)4.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_GIANT_NECROPOLIS_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').GetValue, '(CFixedPoint)5.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_GREAT_LIGHTHOUSE_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').GetValue, '(CFixedPoint)6.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_HYDRAULIC_WORKSHOP_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').GetValue, '(CFixedPoint)7.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_MINING_CITY_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').GetValue, '(CFixedPoint)8.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_GIANT_OBSERVATORY_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').GetValue, '(CFixedPoint)9.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_PALACE_OF_NATIONS_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').GetValue, '(CFixedPoint)1.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_LOCKED_SACRED_MOUNTAIN_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').GetValue, '(CFixedPoint)2.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_LOCKED_TRIUMPHAL_AXIS_TEXT"
