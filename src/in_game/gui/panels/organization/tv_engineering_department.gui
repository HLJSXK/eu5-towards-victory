											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_LOCKED_GREAT_LIGHTHOUSE_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').GetValue, '(CFixedPoint)6.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_LOCKED_HYDRAULIC_WORKSHOP_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').GetValue, '(CFixedPoint)7.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_LOCKED_MINING_CITY_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').GetValue, '(CFixedPoint)8.0')]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_LOCKED_GIANT_OBSERVATORY_TEXT"
											align = nobaseline|left
