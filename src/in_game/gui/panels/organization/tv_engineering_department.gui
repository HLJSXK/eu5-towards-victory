									vbox = {
										layoutpolicy_horizontal = expanding
										text_single = { text = "TV_ENGINEERING_DEMAND_CLERGY" multiline = yes align = nobaseline|left }
										text_single = { text = "TV_ENGINEERING_SOLUTION_CLERGY" multiline = yes align = nobaseline|left }
