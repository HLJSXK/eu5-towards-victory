	}
	blockoverride "country_header_names_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
	}
	blockoverride "country_header_character_name" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').GetCharacter]"
		margin = { 2 0 }
		character_label_name = {
			margin_left = 0
			margin_right = 10
			blockoverride "character_name_text" {
				raw_text = "[Character.GetNameToFit('(int32)40', '(bool)yes')]"
			}
		}
	}
	blockoverride "character_widget" {
		widget = {
			position = { 0 -30 }
			allow_outside = yes
			block "portrait_io_widget" {
				size = { 250 200 }
			}

			block "character_portrait_anchor" {
				parentanchor = bottom
			}

			portrait_standard_full_body_center_button = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
				block "character_right_visible" {
					visible = yes
				}
				parentanchor = bottom

				size = { 250 200 }
				datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').GetCharacter]"
			}

			vbox = {
				visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet)]"
				size = { 250 200 }
				parentanchor = center
				widgetanchor = center
				position = { 0 0 }
				spacing = 2

				expand = {}
				spacer = { size = { 250 50 } }
				text_single = {
					size = { 250 30 }
					raw_text = "+"
					fontsize = 34
					align = center|nobaseline
					default_format = "#yellow_titles"
				}
				text_single = {
					size = { 250 20 }
					text = "TV_IO_HEADER_APPOINT_CHIEF_PROMPT"
					fontsize = 14
					align = center|nobaseline
					default_format = "#high"
				}
				expand = {}
			}

			action_button = {
				visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet)]"
				size = { 250 200 }
				parentanchor = center
				widgetanchor = center
				position = { 0 0 }
				alpha = 0
				alwaystransparent = no
				using = action_button_common_template
				title = "tv_appoint_engineering_leader"
				description = "tv_appoint_engineering_leader_desc"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = { action_name = "tv_appoint_engineering_leader" }
			}

			action_button = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
				size = { 78 26 }
				parentanchor = top|right
				widgetanchor = top|right
				position = { 0 20 }
				using = button_regular_texture_alt_yellow
				using = action_button_common_template
				using = button_common_textobj_template
				fontsize = 13
				title = "tv_change_engineering_leader"
				description = "tv_change_engineering_leader_desc"
				text = "TV_ENGINEERING_CHANGE_LEADER_SHORT"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = { action_name = "tv_change_engineering_leader" }
			}
			action_button = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
				size = { 78 26 }
				parentanchor = top|right
				widgetanchor = top|right
				position = { 0 49 }
				using = button_regular_texture_alt_red
				using = action_button_common_template
				using = button_common_textobj_template
				fontsize = 13
				title = "tv_remove_engineering_leader"
				description = "tv_remove_engineering_leader_desc"
				text = "TV_ENGINEERING_REMOVE_LEADER_SHORT"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = { action_name = "tv_remove_engineering_leader" }
			}
		}
	}

	blockoverride "io_main_actions_icon" {
		texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
	}

	blockoverride "organization_overview_list_custom_top_extra" {
		vbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			ignoreinvisible = yes
			spacing = 10

			tv_engineering_department_card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/location_icons/new/prosperity.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ENGINEERING_CONCEPT_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					vbox = {
							layoutpolicy_horizontal = expanding
							ignoreinvisible = yes
							spacing = 6

							hbox = {
								visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_locked').IsSet)]"
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = fixed
								size = { 470 116 }
								spacing = 10
								margin = { 8 8 }
								using = bg_paper_card_situations

								widget = {
									size = { 76 92 }
									allow_outside = yes

									portrait_standard_head_button = {
										using = character_portrait_bg
										visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet]"
										parentanchor = center
										widgetanchor = center
										size = { 58 72 }
										datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').GetCharacter]"

										icon = {
											block "character_frame_texture" {
												texture = "gfx/interface/component_decoration/character_frames/character_frame_1.dds"
											}
											texture_density = 2
											size = { 100% 100% }
										}
									}
								}

								widget = {
									size = { 368 92 }
									using = bg_text_mask_container_dark_blue
									vbox = {
										margin = { 8 8 }
										layoutpolicy_horizontal = expanding
										ignoreinvisible = yes
										text_multi = {
											visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet)]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_NEEDS_ENGINEER_TEXT"
											align = nobaseline|left
										}
										vbox = {
											visible = "[And(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet)]"
											ignoreinvisible = yes
											spacing = 8
											text_multi = {
												max_width = 352
												autoresize = yes
												text = "TV_ENGINEERING_CONCEPT_IN_PROGRESS_TEXT"
												align = nobaseline|left
											}
											hbox = {
												layoutpolicy_horizontal = fixed
												size = { 352 20 }
												spacing = 6
												text_single = { raw_text = "@adm!" size = { 24 20 } max_width = 24 fontsize = 16 align = center|nobaseline }
												widget = {
													size = { 248 20 }
													progressbar = {
														size = { 248 14 }
														parentanchor = vcenter
														widgetanchor = vcenter
														using = progress_bar_blue_alt
														max = 100
														value = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_wonder_concept_progress').GetValue]"
													}
												}
												text_single = {
													raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText('tv_wonder_concept_progress')]"
													size = { 68 20 }
													max_width = 68
													fontsize = 13
													align = nobaseline|right
												}
											}
										}
										text_multi = {
											visible = "[And(And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_slot_1').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').IsSet), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_mode').IsSet)), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet))]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_TEXT"
											align = nobaseline|left
										}
										text_multi = {
											visible = "[And(And(And3(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_great_engineer_char').IsSet, Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal').IsSet), LessThan_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_stage').GetValue, '(CFixedPoint)1.0')), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_slot_1').IsSet)), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet))]"
											max_width = 352
											autoresize = yes
											text = "TV_ENGINEERING_PROPOSAL_NONE_TEXT"
											align = nobaseline|left
										}
										vbox = {
											visible = "[And(Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_proposal_mode').IsSet), Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_wonder_concept_in_progress').IsSet))]"
