									button_regular = { size = { 54 26 } enabled = no text = "TV_ENGINEERING_REFUTE_SHORT_BUTTON" tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT" }
									button_regular = { size = { 54 26 } enabled = no text = "TV_ENGINEERING_BRIBE_SHORT_BUTTON" tooltip = "TV_ENGINEERING_UI_PLACEHOLDER_TT" }
								}
							}
						}
					}
				}
			}

			card_actions = {
				minimumsize = { 500 110 }
				maximumsize = { 500 110 }

				blockoverride "card_header_text" {
					text = "TV_ENGINEERING_CONCEPT_ACTIONS_TITLE"
				}
