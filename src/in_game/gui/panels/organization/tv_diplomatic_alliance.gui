# Towards Victory — Diplomatic Alliance IO Panel
# Models the header after HRE: tier piechart at (220,60), cohesion at (294,60), leader flag overlay.
# Parliament tab label renamed; laws tab label renamed.

organization_panel = {

	blockoverride "organization_overview_tab_visible" {}

	blockoverride "organization_panel_overview_visible" {
		visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
	}

	blockoverride "organization_members_tab_down" {
		down = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	blockoverride "organization_panel_members_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	# ── Tab label overrides ────────────────────────────────────────────────
	blockoverride "organization_laws_tab_text" {
		text = "TV_ALLIANCE_LAWS_TAB"
	}

	blockoverride "organization_parliament_tab_text" {
		text = "TV_ALLIANCE_ASSEMBLY_TAB"
	}

	blockoverride "organization_parliament_tab_tooltip" {
		tooltipwidget = {
			using = SubTabIOParliamentTooltip
		}
	}

	blockoverride "organization_parliament_vote_cards_hbox" {
		hbox = {
			spacing = 2
			layoutpolicy_horizontal = expanding

			# Support
			io_parliament_vote_card = {
				blockoverride "parliament_card_header" {
					text_single = {
						text = "[InternationalOrganizationsView.GetInternationalOrganization.GetParliament.GetVotedCountriesCount]"
						default_format = "#color_green"
						fontsize = 14
					}
					text_single = {
						fontsize = 14
						raw_text = "[Localize('IO_PARLIAMENT_VOTED')] [Localize('YES')]:"
					}
					expand = {}
					text_single = {
						text = "[InternationalOrganizationsView.GetVotedCountriesVoteStrength|0]"
						default_format = "#color_green"
						fontsize = 14
						tagtooltip_enabled = yes
						tooltip = "[special_status_power|e]"
					}
				}
				blockoverride "parliament_card_list_datamodel" {
					datamodel = "[InternationalOrganizationsView.GetParliamentVotedCountriesWithPlayerFirst]"
				}
				blockoverride "io_parliament_vote_card_row_extra" {
					using = io_parliament_vote_card_row
					blockoverride "bribe_right_action" {}
				}
			}

			# Not yet voted
			io_parliament_vote_card = {
				visible = "[InternationalOrganizationsView.GetInternationalOrganization.GetParliament.IsLawDebate]"
				blockoverride "parliament_card_header_icon" {}
				blockoverride "parliament_card_header" {
					expand = {}
					text_single = {
						align = left
						text = "[InternationalOrganizationsView.GetInternationalOrganization.GetParliament.GetNonVotedCountriesCount]"
						default_format = "#yellow_titles"
					}
					text_single = {
						align = left
						text = "IO_PARLIAMENT_VOTES_LEFT"
					}
					expand = {}
					text_single = {
						text = "[InternationalOrganizationsView.GetNonVotedCountriesVoteStrength|0]"
						default_format = "#yellow_titles"
						tagtooltip_enabled = yes
						tooltip = "[special_status_power|e]"
					}
				}
				blockoverride "parliament_card_list_datamodel" {
					datamodel = "[InternationalOrganizationsView.GetParliamentNonVotedCountriesWithPlayerFirst]"
				}
			}

			# Opposition
			io_parliament_vote_card = {
				blockoverride "parliament_card_header_icon" {
					header_action_button_left = {
						size = { 30 30}
						blockoverride "header_button_icon_size" { size = { 30 30 } }
						blockoverride "header_button_frame_inner" { visible = no }
						blockoverride "icon_overlay" {}
						blockoverride "icon_texture" {
							texture = "gfx/interface/icons/international_organizations/law_voting_no.dds"
						}
						blockoverride "header_button_text_layout" {}
						title = "VOTE_IO_PARLIAMENT"
						description = "vote_in_organization_parliament_desc"
						actor = "[InternationalOrganizationsView.GetPlayer]"
						parameter = {
							parameter_name = "recipient"
							parameter_value = "[InternationalOrganizationsView.GetInternationalOrganization]"
						}
						parameter = {
							parameter_name = "vote"
							parameter_value_bool = no
						}
						left_action = { action_name = "vote_in_organization_parliament" }
						tooltipwidget = {
							using = io_parliament_vote_button_tooltip
						}
					}
				}
				blockoverride "io_parliament_vote_card_row_extra" {
					using = io_parliament_vote_card_row
					blockoverride "bribe_left_action" {}
				}
			}
		}
	}

	blockoverride "country_header_character_visible" {
		visible = yes
	}
	blockoverride "country_header_religion" {}
	blockoverride "extra_titles" {}
	blockoverride "country_header_names_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').IsSet]"
	}
	blockoverride "country_header_character_name" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').GetCharacter]"
		margin = { 2 0 }
		character_label_name = {
			margin_left = 0
			margin_right = 10
			blockoverride "character_name_text" {
				raw_text = "[Character.GetNameToFit('(int32)40', '(bool)yes')]"
			}
		}
	}
	blockoverride "character_widget" {
		widget = {
			position = { 0 -30 }
			allow_outside = yes
			block "portrait_io_widget" {
				size = { 250 200 }
			}

			block "character_portrait_anchor" {
				parentanchor = bottom
			}

			portrait_standard_full_body_center_button = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').IsSet]"
				block "character_right_visible" {
					visible = yes
				}
				parentanchor = bottom

				size = { 250 200 }
				datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').GetCharacter]"
			}

			vbox = {
				visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').IsSet)]"
				size = { 250 200 }
				parentanchor = center
				widgetanchor = center
				position = { 0 0 }
				spacing = 2

				expand = {}
				spacer = { size = { 250 50 } }
				text_single = {
					size = { 250 30 }
					raw_text = "+"
					fontsize = 34
					align = center|nobaseline
					default_format = "#yellow_titles"
				}
				text_single = {
					size = { 250 20 }
					text = "TV_IO_HEADER_APPOINT_CHIEF_PROMPT"
					fontsize = 14
					align = center|nobaseline
					default_format = "#high"
				}
				expand = {}
			}

			action_button = {
				visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').IsSet)]"
				size = { 250 200 }
				parentanchor = center
				widgetanchor = center
				position = { 0 0 }
				alpha = 0
				alwaystransparent = no
				using = action_button_common_template
				title = "tv_appoint_alliance_leader"
				description = "tv_appoint_alliance_leader_desc"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = { action_name = "tv_appoint_alliance_leader" }
			}

			action_button = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').IsSet]"
				size = { 78 26 }
				parentanchor = top|right
				widgetanchor = top|right
				position = { 0 20 }
				using = button_regular_texture_alt_yellow
				using = action_button_common_template
				using = button_common_textobj_template
				fontsize = 13
				title = "tv_change_alliance_leader"
				description = "tv_change_alliance_leader_desc"
				text = "TV_ALLIANCE_CHANGE_LEADER_SHORT"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = { action_name = "tv_change_alliance_leader" }
			}
			action_button = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').IsSet]"
				size = { 78 26 }
				parentanchor = top|right
				widgetanchor = top|right
				position = { 0 49 }
				using = button_regular_texture_alt_red
				using = action_button_common_template
				using = button_common_textobj_template
				fontsize = 13
				title = "tv_remove_alliance_leader"
				description = "tv_remove_alliance_leader_desc"
				text = "TV_ALLIANCE_REMOVE_LEADER_SHORT"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = { action_name = "tv_remove_alliance_leader" }
			}
		}
	}

	blockoverride "io_main_actions_icon" {
		texture = "gfx/interface/icons/flat_icons/diplomatic_reputation.dds"
	}

	blockoverride "scroll_overview_empty_visible" { visible = no }

	# ── Header decoration (behind character portrait) ──────────────────────
	# Mirrors HRE io_decoration_behind_character layout:
	#   (220,60) → tier piechart (centralization level, 0-15)
	#   (294,60) → cohesion value (alliance resource)
	#   center-top → leader country flag
	blockoverride "io_decoration_behind_character" {

		# Alliance Tier — large piechart at fixed position
		# DataModelFirst picks tv_alliance_tier (first variable in the variables block).
		widget = {
			allow_outside = yes
			ignore_layout = yes
			position = { 220 60 }
			visible = "[GreaterThan_int32(GetDataModelSize(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetVariables), '(int32)0')]"
			using = layoutpolicy_expanding
			datamodel = "[DataModelFirst(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetVariables, '(int32)1')]"
			item = {
				vbox = {
					using = layoutpolicy_expanding
					spacing = 5
					tooltipwidget = {
						using = IOVariableTooltip
					}
					hbox = {
						using = organization_piechart_template
						blockoverride "organization_piechart_size" { size = { 28 28 } }
						blockoverride "organization_piechart_value" {
							value = "[Subtract_float(FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.GetVariable(InternationalOrganizationTypeVariable.GetTag)),FixedPointToFloat(InternationalOrganizationTypeVariable.GetMin))]"
						}
						blockoverride "organization_piechart_max_value" {
							value = "[Subtract_float(FixedPointToFloat(InternationalOrganizationTypeVariable.GetMax), FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.GetVariable(InternationalOrganizationTypeVariable.GetTag)))]"
						}
						blockoverride "organization_piechart_icon" {
							texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableIcon(InternationalOrganizationTypeVariable.GetTag)]"
						}
					}
					text_single = {
						autoresize = yes
						minimumsize = { 35 21 }
						maximumsize = { 35 21 }
						align = center
						text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText(InternationalOrganizationTypeVariable.GetTag)]"
					}
				}
			}
		}

		# Alliance Cohesion — circular icon + value at fixed position (mirrors HRE treasury)
		widget = {
			allow_outside = yes
			ignore_layout = yes
			position = { 294 60 }
			vbox = {
				spacing = 5
				widget = {
					size = { 28 28 }
					using = bg_circle
					using = bg_circle_piechart
					icon = {
						texture = "gfx/interface/icons/flat_icons/diplomatic_reputation.dds"
						size = { 95% 95% }
						parentanchor = center
					}
				}
				text_single = {
					autoresize = yes
					minimumsize = { 35 21 }
					maximumsize = { 35 21 }
					align = center
					text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_alliance_cohesion').GetValue|1]"
				}
			}
		}

		# Leader country flag overlay (mirrors HRE emperor flag)
		widget = {
			size = { 137 112 }
			parentanchor = hcenter|top
			position = { 0 -40 }
			allow_outside = yes
			country_flag_mid = {
				parentanchor = center
				datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry]"
			}
		}
	}

	# ── Leader management actions ─────────────────────────────────────────
	blockoverride "organization_main_actions_extra_visible" {
		visible = yes
	}

	blockoverride "organization_main_actions_extra" {
		text_multi = {
			layoutpolicy_horizontal = expanding
			max_width = 450
			autoresize = yes
			text = "TV_DIPLOMATIC_ALLIANCE_OVERVIEW_DESC"
		}
		vbox = {
			layoutpolicy_horizontal = expanding
			ignoreinvisible = yes
			spacing = 6
			text_multi = {
				layoutpolicy_horizontal = expanding
				max_width = 450
				text = "TV_DIPLOMATIC_ALLIANCE_MEMBER_MANAGEMENT_DESC"
			}
			action_button_diamond = {
				size = { 470 30 }
				text = "tv_invite_to_diplomatic_alliance"
				title = "tv_invite_to_diplomatic_alliance"
				description = "tv_invite_to_diplomatic_alliance_desc"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = {
					action_name = "tv_invite_to_diplomatic_alliance"
					action_direction = "offer"
				}
			}
			action_button_diamond = {
				size = { 470 30 }
				text = "tv_expel_diplomatic_alliance_member"
				title = "tv_expel_diplomatic_alliance_member"
				description = "tv_expel_diplomatic_alliance_member_desc"
				actor = "[InternationalOrganizationsView.GetPlayer]"
				left_action = {
					action_name = "tv_expel_diplomatic_alliance_member"
				}
			}
		}
	}

	# -- Alliance Pillars tab --------------------------------------------------
	blockoverride "organization_custom_tab_visible" {
		visible = yes
	}
	blockoverride "organization_custom_tab_text" {
		text = "TV_ALLIANCE_PILLARS_TAB"
	}
	blockoverride "organization_custom_tab_tooltip" {
		tooltip = "TV_ALLIANCE_PILLARS_TAB_TOOLTIP"
	}

	blockoverride "organization_custom_content_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'custom' )]"
	}

	blockoverride "organization_custom_content" {
		margin_top = -5
		spacing = 0
		layoutpolicy_vertical = expanding

		scrollarea = {
			using = layoutpolicy_expanding
			scrollbarpolicy_horizontal = always_off

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}

			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					ignoreinvisible = yes
					spacing = 10
					margin = { 10 2 }

					card_common = {
						maximumsize = { 500 -1 }
						blockoverride "common_header_icon" {}
						blockoverride "common_header_text" {
							text = "TV_ALLIANCE_PILLARS_ACTIVE_PILLAR_HEADER"
						}
						blockoverride "common_bottom_content" {
							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = fixed
								spacing = 10
								margin = { 4 6 }
								text_single = {
									size = { 34 34 }
									raw_text = "@legitimacy!"
									fontsize = 28
									align = center
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									text = "TV_ALLIANCE_PILLAR_SUBLIME_EMPIRE"
									fontsize = 20
									align = nobaseline|left
								}
							}
						}
					}

					widget = {
						size = { 470 42 }
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 4
							hbox = {
								layoutpolicy_horizontal = expanding
								text_single = {
									text = "TV_ALLIANCE_PILLAR_COHESION_PROGRESS"
									align = nobaseline|left
								}
								expand = {}
								text_single = {
									raw_text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_alliance_cohesion').GetValue|1]/100"
									align = nobaseline|right
								}
							}
							widget = {
								size = { 470 18 }
								progressbar = {
									size = { 470 18 }
									max = 100
									value = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_alliance_cohesion').GetValue]"
									using = progress_bar_blue_alt
								}
							}
						}
					}

					card_common = {
						maximumsize = { 500 -1 }
						blockoverride "common_header_icon" {}
						blockoverride "common_header_text" {
							text = "TV_ALLIANCE_SUBLIME_EMPIRE_MEMBERS_HEADER"
						}
						blockoverride "common_bottom_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = fixed
								ignoreinvisible = yes
								spacing = 5
								margin = { 4 4 }
								datamodel = "[InternationalOrganizationsView.GetMemberItems]"
								item = {
									vbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = fixed
										ignoreinvisible = yes
										spacing = 5
										visible = "[And(Not(IsDataModelEmpty(MemberTypeItem.GetCountries)), MemberTypeItem.IsAllMembers)]"
										datamodel = "[MemberTypeItem.GetCountries]"
										item = {
											widget = {
												visible = "[And(Not(ObjectsEqual(Country.Self, InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.Self)), Not(Country.GetDiplomacy.IsSubject))]"
												size = { 470 34 }
												paper_simple_card = {
													size = { 470 34 }
													hbox = {
														layoutpolicy_horizontal = expanding
														layoutpolicy_vertical = fixed
														margin = { 6 4 }
														spacing = 8
														country_flag_small = {}
														text_single = {
															layoutpolicy_horizontal = expanding
															text = "[Country.GetName]"
															align = nobaseline|left
														}
														expand = {}
														text_single = {
															size = { 74 24 }
															raw_text = "[Multiply_CFixedPoint(GetMilitaryStrengthRatio(Country.Self, InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.Self), '(CFixedPoint)100.0')|0]%"
															tooltip = "TV_ALLIANCE_SUBJUGATION_RELATIVE_STRENGTH_TOOLTIP"
															align = nobaseline|right
														}
														action_button = {
															size = { 62 24 }
															enabled = "[GreaterThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_alliance_cohesion').GetValue, Add_CFixedPoint(Multiply_CFixedPoint(GetMilitaryStrengthRatio(Country.Self, InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry.Self), '(CFixedPoint)50.0'), '(CFixedPoint)10.0'))]"
															using = button_regular_texture_alt_red
															using = action_button_common_template
															using = button_common_textobj_template
															fontsize = 13
															text = "TV_ALLIANCE_SUBJUGATE_BUTTON"
															title = "tv_alliance_sublime_empire_subjugate_member"
															description = "tv_alliance_sublime_empire_subjugate_member_desc"
															actor = "[InternationalOrganizationsView.GetPlayer]"
															parameter = {
																parameter_name = "target"
																parameter_value = "[Country.MakeScope]"
															}
															left_action = {
																action_name = "tv_alliance_sublime_empire_subjugate_member"
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}

					expand = {}
				}
			}
		}
	}
}
