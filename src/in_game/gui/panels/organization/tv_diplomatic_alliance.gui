# Towards Victory — Diplomatic Alliance IO Panel
# Models the header after HRE: tier piechart at (220,60), cohesion at (294,60), leader flag overlay.
# Parliament tab label renamed; laws tab label renamed.

organization_panel = {

	# ── Tab label overrides ────────────────────────────────────────────────
	blockoverride "organization_laws_tab_text" {
		text = "TV_ALLIANCE_LAWS_TAB"
	}

	blockoverride "organization_parliament_tab_text" {
		text = "TV_ALLIANCE_ASSEMBLY_TAB"
	}

	blockoverride "organization_parliament_tab_tooltip" {
		tooltipwidget = {
			using = SubTabIOParliamentTooltip
		}
	}

	blockoverride "country_header_character_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').IsSet]"
	}
	blockoverride "country_header_character_context" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').GetCharacter]"
	}
	blockoverride "country_header_religion" {}
	blockoverride "extra_titles" {}
	blockoverride "country_header_names_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').IsSet]"
	}
	blockoverride "country_header_character_name" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').GetCharacter]"
		margin = { 2 0 }
		character_label_name = {
			margin_left = 0
			margin_right = 10
			blockoverride "character_name_text" {
				raw_text = "[Character.GetNameToFit('(int32)40', '(bool)yes')]"
			}
		}
	}

	blockoverride "io_main_actions_icon" {
		texture = "gfx/interface/icons/flat_icons/diplomatic_reputation.dds"
	}

	# ── Header decoration (behind character portrait) ──────────────────────
	# Mirrors HRE io_decoration_behind_character layout:
	#   (220,60) → tier piechart (centralization level, 0-15)
	#   (294,60) → cohesion value (alliance resource)
	#   center-top → leader country flag
	blockoverride "io_decoration_behind_character" {

		# Alliance Tier — large piechart at fixed position
		# DataModelFirst picks tv_alliance_tier (first variable in the variables block).
		widget = {
			allow_outside = yes
			ignore_layout = yes
			position = { 220 60 }
			visible = "[GreaterThan_int32(GetDataModelSize(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetVariables), '(int32)0')]"
			using = layoutpolicy_expanding
			datamodel = "[DataModelFirst(InternationalOrganizationsView.GetInternationalOrganization.GetType.GetVariables, '(int32)1')]"
			item = {
				vbox = {
					using = layoutpolicy_expanding
					spacing = 5
					tooltipwidget = {
						using = IOVariableTooltip
					}
					hbox = {
						using = organization_piechart_template
						blockoverride "organization_piechart_size" { size = { 28 28 } }
						blockoverride "organization_piechart_value" {
							value = "[Subtract_float(FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.GetVariable(InternationalOrganizationTypeVariable.GetTag)),FixedPointToFloat(InternationalOrganizationTypeVariable.GetMin))]"
						}
						blockoverride "organization_piechart_max_value" {
							value = "[Subtract_float(FixedPointToFloat(InternationalOrganizationTypeVariable.GetMax), FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.GetVariable(InternationalOrganizationTypeVariable.GetTag)))]"
						}
						blockoverride "organization_piechart_icon" {
							texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableIcon(InternationalOrganizationTypeVariable.GetTag)]"
						}
					}
					text_single = {
						autoresize = yes
						minimumsize = { 35 21 }
						maximumsize = { 35 21 }
						align = center
						text = "[InternationalOrganizationsView.GetInternationalOrganization.GetVariableText(InternationalOrganizationTypeVariable.GetTag)]"
					}
				}
			}
		}

		# Alliance Cohesion — circular icon + value at fixed position (mirrors HRE treasury)
		widget = {
			allow_outside = yes
			ignore_layout = yes
			position = { 294 60 }
			vbox = {
				spacing = 5
				widget = {
					size = { 28 28 }
					using = bg_circle
					using = bg_circle_piechart
					icon = {
						texture = "gfx/interface/icons/flat_icons/diplomatic_reputation.dds"
						size = { 95% 95% }
						parentanchor = center
					}
				}
				text_single = {
					autoresize = yes
					minimumsize = { 35 21 }
					maximumsize = { 35 21 }
					align = center
					text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_alliance_cohesion').GetValue|1]"
				}
			}
		}

		# Leader country flag overlay (mirrors HRE emperor flag)
		widget = {
			size = { 137 112 }
			parentanchor = hcenter|top
			position = { 0 -40 }
			allow_outside = yes
			country_flag_mid = {
				parentanchor = center
				datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry]"
			}
		}
	}

	# ── Leader management actions ─────────────────────────────────────────
	blockoverride "organization_main_actions_extra_visible" {
		visible = yes
	}

	blockoverride "organization_main_actions_extra" {
		action_button_diamond = {
			size = { 470 30 }
			visible = "[Not(Player.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').IsSet)]"
			text = "tv_appoint_alliance_leader"
			title = "tv_appoint_alliance_leader"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_appoint_alliance_leader"
			}
		}
		action_button_diamond = {
			size = { 470 30 }
			visible = "[Player.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').IsSet]"
			text = "tv_change_alliance_leader"
			title = "tv_change_alliance_leader"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_change_alliance_leader"
			}
		}
		action_button_diamond = {
			size = { 470 30 }
			visible = "[Player.MakeScope.GetVariable('tv_diplomatic_alliance_leader_char').IsSet]"
			text = "tv_remove_alliance_leader"
			title = "tv_remove_alliance_leader"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_remove_alliance_leader"
			}
		}
	}
}
