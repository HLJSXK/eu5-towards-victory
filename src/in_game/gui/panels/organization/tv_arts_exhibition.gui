# Towards Victory — Arts Exhibition IO Panel
# Shows the three cultural action buttons (Send Artist Abroad, Host Domestic Exhibition)
# plus the three IO leader management actions (Appoint / Remove / Change Leader).
# The IO's character leader (an artist) is shown in the standard IO header.

organization_panel = {

	blockoverride "organization_overview_tab_visible" {}

	blockoverride "organization_panel_overview_visible" {
		visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
	}

	blockoverride "organization_members_tab_down" {
		down = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	blockoverride "organization_panel_members_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	blockoverride "scroll_overview_empty_visible" { visible = no }

	blockoverride "io_main_actions_icon" {
		texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetIcon]"
	}

	blockoverride "organization_main_actions_extra_visible" {
		visible = yes
	}

	blockoverride "organization_main_actions_extra" {

		# ── Cultural actions ──────────────────────────────────────────────────
		action_button_diamond = {
			size = { 470 30 }
			text = "tv_send_artist_abroad"
			title = "tv_send_artist_abroad"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_send_artist_abroad"
			}
		}
		action_button_diamond = {
			size = { 470 30 }
			text = "tv_host_domestic_exhibition"
			title = "tv_host_domestic_exhibition"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_host_domestic_exhibition"
			}
		}

		# ── IO Leader management ──────────────────────────────────────────────
		# Visibility is gated by the appointed-leader country variable on the player.
		action_button_diamond = {
			size = { 470 30 }
			visible = "[Not(Player.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet)]"
			text = "tv_appoint_arts_leader"
			title = "tv_appoint_arts_leader"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_appoint_arts_leader"
			}
		}
		action_button_diamond = {
			size = { 470 30 }
			visible = "[Player.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet]"
			text = "tv_change_arts_leader"
			title = "tv_change_arts_leader"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_change_arts_leader"
			}
		}
		action_button_diamond = {
			size = { 470 30 }
			visible = "[Player.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet]"
			text = "tv_remove_arts_leader"
			title = "tv_remove_arts_leader"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_remove_arts_leader"
			}
		}
	}
}
