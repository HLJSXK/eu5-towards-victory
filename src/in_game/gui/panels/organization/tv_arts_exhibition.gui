# Towards Victory — Arts Exhibition IO Panel
# Shows cultural touring controls in overview, Chief Artist management and
# effect summary in the resolutions tab, and domestic exhibitions in a custom tab.
# The IO's character leader (an artist) is shown in the standard IO header.

organization_panel = {

	blockoverride "organization_overview_tab_visible" {}

	blockoverride "organization_panel_overview_visible" {
		visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
	}

	blockoverride "organization_members_tab_down" {
		down = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	blockoverride "organization_panel_members_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	blockoverride "organization_resolutions_tab_visible" {
		visible = yes
	}
	blockoverride "organization_resolutions_tab_text" {
		text = "TV_ARTS_CHIEF_ARTIST_TAB"
	}
	blockoverride "organization_resolutions_tooltip" {
		tooltip = "TV_ARTS_CHIEF_ARTIST_TAB_TOOLTIP"
	}

	blockoverride "organization_laws_tab_visible" {
		visible = yes
	}
	blockoverride "organization_laws_tab_text" {
		text = "TV_ARTS_EXCHANGE_TAB"
	}

	blockoverride "scroll_overview_empty_visible" { visible = no }

	blockoverride "country_header_character_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet]"
	}
	blockoverride "country_header_character_context" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exhibition_leader_char').GetCharacter]"
	}
	blockoverride "country_header_religion" {}
	blockoverride "extra_titles" {}
	blockoverride "country_header_names_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet]"
	}
	blockoverride "country_header_character_name" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exhibition_leader_char').GetCharacter]"
		margin = { 2 0 }
		character_label_name = {
			margin_left = 0
			margin_right = 10
			blockoverride "character_name_text" {
				raw_text = "[Character.GetNameToFit('(int32)40', '(bool)yes')]"
			}
		}
	}

	blockoverride "io_main_actions_icon" {
		texture = "gfx/interface/icons/flat_icons/cultural_influence.dds"
	}

	blockoverride "organization_main_actions_extra_visible" {
		visible = yes
	}

	blockoverride "organization_overview_list_custom_top_extra" {
		vbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding

			card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/cultural_influence.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ARTS_DISPATCHED_ARTISTS_HEADER"
				}

				blockoverride "common_bottom_content" {
					widget = {
						size = { 470 214 }
						datacontext = "[InternationalOrganizationsView.GetPlayer]"

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							margin = { 4 6 }

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = {
									text = "TV_ARTS_DISPATCHED_COUNT_LABEL"
									align = nobaseline
								}
								expand = {}
								text_single = {
									raw_text = "[Country.MakeScope.GetVariable('tv_dispatched_artists_count').GetValue|0]"
									align = nobaseline
								}
							}

							scrollarea = {
								size = { 458 164 }
								scrollbarpolicy_horizontal = always_off

								scrollbar_vertical = {
									using = Scrollbar_Vertical
								}

								scrollwidget = {
									fixedgridbox = {
										addcolumn = 98%
										addrow = 80

										datamodel = "[Country.MakeScope.GetList('tv_dispatched_artists_list')]"

										item = {
											widget = {
												size = { 100% 80 }

												io_character_card = {
													size = { 97% 72 }
													parentanchor = hcenter
													using = layoutpolicy_expanding
													datacontext = "[Scope.GetCharacter]"
													blockoverride "name_highlight" {}
													blockoverride "character_entry_name_sort_by_highlight" {}

													blockoverride "character_button_pin" {
														visible = no
													}
													blockoverride "character_abilities_visible" {
														visible = no
													}
													blockoverride "artist_abilities_visible" {
														visible = yes
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

	blockoverride "organization_main_actions_extra" {
		action_button_diamond = {
			size = { 470 30 }
			text = "tv_send_artist_abroad"
			title = "tv_send_artist_abroad"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_send_artist_abroad"
			}
		}
	}

	# ── Chief Artist tab: reuse the vanilla resolutions slot -------------------
	blockoverride "organization_resolutions_content" {
		margin = { 0 0 }

		vbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = fixed
			ignoreinvisible = yes
			spacing = 10

			card_common = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet]"
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/cultural_influence.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ARTS_CHIEF_ARTIST_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					io_character_card = {
						datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exhibition_leader_char').GetCharacter]"
						using = layoutpolicy_expanding
						blockoverride "name_highlight" {}
						blockoverride "character_entry_name_sort_by_highlight" {}
						blockoverride "character_button_pin" {
							visible = no
						}
						blockoverride "character_abilities_visible" {
							visible = no
						}
						blockoverride "artist_abilities_visible" {
							visible = yes
						}
					}
				}
			}

			card_common = {
				visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet)]"
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/cultural_influence.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ARTS_CHIEF_ARTIST_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					widget = {
						size = { 470 44 }
						vbox = {
							margin = { 4 6 }
							text_single = {
								text = "TV_ARTS_NO_CHIEF_ARTIST"
								align = nobaseline|left
							}
						}
					}
				}
			}

			card_common = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet]"
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/cultural_influence.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ARTS_CHIEF_ARTIST_EFFECTS_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					widget = {
						size = { 470 58 }
						datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exhibition_leader_char').GetCharacter]"

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							margin = { 4 6 }

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4

								text_single = {
									raw_text = "@cultural_influence!"
									tooltip = "TV_ARTS_CHIEF_ARTIST_INFLUENCE_EFFECT_TOOLTIP"
									align = nobaseline
								}
								text_single = {
									text = "TV_ARTS_CHIEF_ARTIST_INFLUENCE_EFFECT_LABEL"
									tooltip = "TV_ARTS_CHIEF_ARTIST_INFLUENCE_EFFECT_TOOLTIP"
									align = nobaseline
								}
								expand = {}
								hbox = {
									spacing = 2
									text_single = {
										raw_text = "[Multiply_CFixedPoint(Character.GetArtistSkill, '(CFixedPoint)0.1')|+=2]"
										tooltip = "TV_ARTS_CHIEF_ARTIST_INFLUENCE_EFFECT_TOOLTIP"
										align = nobaseline
									}
									text_single = {
										text = "TV_ARTS_PER_MONTH_SUFFIX"
										tooltip = "TV_ARTS_CHIEF_ARTIST_INFLUENCE_EFFECT_TOOLTIP"
										align = nobaseline
									}
								}
							}
						}
					}
				}
			}

			card_actions = {
				minimumsize = { 500 150 }
				maximumsize = { 500 150 }

				blockoverride "card_header_text" {
					text = "MAIN_ACTIONS"
				}

				blockoverride "card_header_icon" {
					block "io_main_actions_icon" {
						texture = "gfx/interface/icons/flat_icons/cultural_influence.dds"
					}
				}

				blockoverride "actions_override" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 2

						action_button_diamond = {
							size = { 470 30 }
							visible = "[Not(Player.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet)]"
							text = "tv_appoint_arts_leader"
							title = "tv_appoint_arts_leader"
							actor = "[InternationalOrganizationsView.GetPlayer]"
							left_action = {
								action_name = "tv_appoint_arts_leader"
							}
						}
						action_button_diamond = {
							size = { 470 30 }
							visible = "[Player.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet]"
							text = "tv_change_arts_leader"
							title = "tv_change_arts_leader"
							actor = "[InternationalOrganizationsView.GetPlayer]"
							left_action = {
								action_name = "tv_change_arts_leader"
							}
						}
						action_button_diamond = {
							size = { 470 30 }
							visible = "[Player.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet]"
							text = "tv_remove_arts_leader"
							title = "tv_remove_arts_leader"
							actor = "[InternationalOrganizationsView.GetPlayer]"
							left_action = {
								action_name = "tv_remove_arts_leader"
							}
						}
					}
				}
			}
		}

		expand = {}
	}

	# ── Arts exchange tab: reuse the vanilla laws slot -------------------------
	blockoverride "organization_laws_subheader" {
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10

			card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/cultural_influence.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ARTS_EXCHANGE_INFO_HEADER"
				}

				blockoverride "common_bottom_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						margin = { 4 6 }
						ignoreinvisible = yes

						text_single = {
							layoutpolicy_horizontal = expanding
							visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exchange_active').IsSet)]"
							text = "TV_ARTS_EXCHANGE_INACTIVE_HINT"
							multiline = yes
							align = nobaseline|left
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exchange_active').IsSet]"
							spacing = 8

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = {
									text = "TV_ARTS_EXCHANGE_REMAINING_LABEL"
									align = nobaseline
								}
								expand = {}
								text_single = {
									raw_text = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exchange_months_remaining').GetValue|0]/12"
									align = nobaseline
								}
							}

							progressbar = {
								size = { 462 16 }
								using = progress_bar_blue_alt
								min = 0
								max = 12
								value = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exchange_months_remaining').GetValue]"
							}

							text_single = {
								text = "TV_ARTS_EXCHANGE_PARTICIPANTS_LABEL"
								align = nobaseline|left
							}

							scrollarea = {
								size = { 470 240 }
								scrollbarpolicy_horizontal = always_off

								scrollbar_vertical = {
									using = Scrollbar_Vertical
								}

								scrollwidget = {
									fixedgridbox = {
										addcolumn = 98%
										addrow = 80

										datamodel = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetList('tv_arts_exchange_participants')]"

										item = {
											widget = {
												size = { 100% 80 }

												io_character_card = {
													size = { 97% 72 }
													parentanchor = hcenter
													using = layoutpolicy_expanding
													datacontext = "[Scope.GetCharacter]"
													blockoverride "name_highlight" {}
													blockoverride "character_entry_name_sort_by_highlight" {}

													blockoverride "character_button_pin" {
														visible = no
													}
													blockoverride "character_abilities_visible" {
														visible = no
													}
													blockoverride "artist_abilities_visible" {
														visible = yes
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}

			card_actions = {
				minimumsize = { 500 120 }
				maximumsize = { 500 120 }

				blockoverride "card_header_text" {
					text = "MAIN_ACTIONS"
				}

				blockoverride "card_header_icon" {
					block "io_main_actions_icon" {
						texture = "gfx/interface/icons/flat_icons/cultural_influence.dds"
					}
				}

				blockoverride "actions_override" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 2

						action_button_diamond = {
							size = { 470 30 }
							visible = "[Not(Player.MakeScope.GetVariable('tv_arts_exchange_active').IsSet)]"
							text = "tv_start_arts_exchange"
							title = "tv_start_arts_exchange"
							actor = "[InternationalOrganizationsView.GetPlayer]"
							left_action = { action_name = "tv_start_arts_exchange" }
						}
						action_button_diamond = {
							size = { 470 30 }
							visible = "[Player.MakeScope.GetVariable('tv_arts_exchange_active').IsSet]"
							text = "tv_invite_domestic_arts_exchange_artist"
							title = "tv_invite_domestic_arts_exchange_artist"
							actor = "[InternationalOrganizationsView.GetPlayer]"
							left_action = { action_name = "tv_invite_domestic_arts_exchange_artist" }
						}
						action_button_diamond = {
							size = { 470 30 }
							visible = "[Player.MakeScope.GetVariable('tv_arts_exchange_active').IsSet]"
							text = "tv_invite_foreign_arts_exchange_artist"
							title = "tv_invite_foreign_arts_exchange_artist"
							actor = "[InternationalOrganizationsView.GetPlayer]"
							left_action = { action_name = "tv_invite_foreign_arts_exchange_artist" }
						}
					}
				}
			}
		}
	}

	# ── Domestic exhibition tab ───────────────────────────────────────────────
	blockoverride "organization_custom_tab_visible" {
		visible = yes
	}
	blockoverride "organization_custom_tab_text" {
		text = "TV_ARTS_DOMESTIC_EXHIBITION_INFO_HEADER"
	}
	blockoverride "organization_custom_tab_tooltip" {
		tooltip = "tv_host_domestic_exhibition_desc"
	}

	blockoverride "organization_custom_content_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'custom' )]"
	}

	blockoverride "organization_custom_content" {
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10
			margin = { 10 2 }

			card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/cultural_influence.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ARTS_DOMESTIC_EXHIBITION_INFO_HEADER"
				}

				blockoverride "common_bottom_content" {
					widget = {
						size = { 470 212 }
						datacontext = "[InternationalOrganizationsView.GetPlayer]"

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							margin = { 4 6 }

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = {
									text = "TV_ARTS_OWNED_ARTWORKS_LABEL"
									align = nobaseline
								}
								expand = {}
								text_single = {
									raw_text = "[Country.GetNumWorksOfArt|0]"
									align = nobaseline
								}
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = {
									text = "TV_ARTS_LOCAL_EXHIBITION_COMMITTED_LABEL"
									align = nobaseline
								}
								expand = {}
								text_single = {
									raw_text = "[Country.MakeScope.GetVariable('tv_local_exhibition_artworks_committed').GetValue|0]"
									align = nobaseline
								}
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = {
									text = "TV_ARTS_LOCAL_EXHIBITION_LOCATIONS_LABEL"
									align = nobaseline
								}
								expand = {}
								text_single = {
									raw_text = "[Country.MakeScope.GetVariable('tv_local_exhibition_location_count').GetValue|0]"
									align = nobaseline
								}
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = {
									text = "TV_ARTS_LOCAL_EXHIBITION_DURATION_LABEL"
									tooltip = "TV_ARTS_LOCAL_EXHIBITION_PROGRESS_TOOLTIP"
									align = nobaseline
								}
								expand = {}
								text_single = {
									raw_text = "[Country.MakeScope.GetVariable('tv_local_exhibition_duration').GetValue|0]/24"
									tooltip = "TV_ARTS_LOCAL_EXHIBITION_PROGRESS_TOOLTIP"
									align = nobaseline
								}
							}
							progressbar = {
								size = { 462 16 }
								using = progress_bar_blue_alt
								min = 0
								max = 24
								value = "[Country.MakeScope.GetVariable('tv_local_exhibition_duration').GetValue]"
								tooltip = "TV_ARTS_LOCAL_EXHIBITION_PROGRESS_TOOLTIP"
							}
							hbox = {
								size = { 462 22 }
								tooltip = "TV_ARTS_LOCAL_EXHIBITION_PROGRESS_TOOLTIP"

								widget = {
									size = { 231 22 }
									hbox = {
										size = { 231 22 }
										spacing = 1
										hbox = {
											spacing = 1
											text_single = {
												autoresize = yes
												text = "TV_ARTS_LOCAL_EXHIBITION_TIER_1_MARKER"
												align = nobaseline|left
												using = Font_Size_Very_Small
												tooltip = "TV_ARTS_LOCAL_EXHIBITION_PROGRESS_TOOLTIP"
											}
											text_single = {
												visible = "[GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_local_exhibition_rating').GetValue, '(CFixedPoint)1.0')]"
												autoresize = yes
												raw_text = "@trigger_yes!"
												align = nobaseline|left
												using = Font_Size_Very_Small
												tooltip = "TV_ARTS_LOCAL_EXHIBITION_PROGRESS_TOOLTIP"
											}
										}
										expand = {}
										hbox = {
											spacing = 1
											text_single = {
												autoresize = yes
												text = "TV_ARTS_LOCAL_EXHIBITION_TIER_2_MARKER"
												align = nobaseline|right
												using = Font_Size_Very_Small
												tooltip = "TV_ARTS_LOCAL_EXHIBITION_PROGRESS_TOOLTIP"
											}
											text_single = {
												visible = "[GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_local_exhibition_rating').GetValue, '(CFixedPoint)2.0')]"
												autoresize = yes
												raw_text = "@trigger_yes!"
												align = nobaseline|right
												using = Font_Size_Very_Small
												tooltip = "TV_ARTS_LOCAL_EXHIBITION_PROGRESS_TOOLTIP"
											}
										}
									}
								}
								widget = {
									size = { 116 22 }
									hbox = {
										size = { 116 22 }
										expand = {}
										hbox = {
											spacing = 1
											text_single = {
												autoresize = yes
												text = "TV_ARTS_LOCAL_EXHIBITION_TIER_3_MARKER"
												align = nobaseline|right
												using = Font_Size_Very_Small
												tooltip = "TV_ARTS_LOCAL_EXHIBITION_PROGRESS_TOOLTIP"
											}
											text_single = {
												visible = "[GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_local_exhibition_rating').GetValue, '(CFixedPoint)3.0')]"
												autoresize = yes
												raw_text = "@trigger_yes!"
												align = nobaseline|right
												using = Font_Size_Very_Small
												tooltip = "TV_ARTS_LOCAL_EXHIBITION_PROGRESS_TOOLTIP"
											}
										}
									}
								}
								widget = {
									size = { 115 22 }
									hbox = {
										size = { 115 22 }
										expand = {}
										hbox = {
											spacing = 1
											text_single = {
												autoresize = yes
												text = "TV_ARTS_LOCAL_EXHIBITION_TIER_4_MARKER"
												align = nobaseline|right
												using = Font_Size_Very_Small
												tooltip = "TV_ARTS_LOCAL_EXHIBITION_PROGRESS_TOOLTIP"
											}
											text_single = {
												visible = "[GreaterThanOrEqualTo_CFixedPoint(Country.MakeScope.GetVariable('tv_local_exhibition_rating').GetValue, '(CFixedPoint)4.0')]"
												autoresize = yes
												raw_text = "@trigger_yes!"
												align = nobaseline|right
												using = Font_Size_Very_Small
												tooltip = "TV_ARTS_LOCAL_EXHIBITION_PROGRESS_TOOLTIP"
											}
										}
									}
								}
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 6
								text_single = {
									raw_text = "@trigger_no!"
									tooltip = "TV_ARTS_LOCAL_EXHIBITION_COLD_TT"
									align = nobaseline
								}
								progressbar = {
									size = { 394 16 }
									using = progress_bar_blue_alt
									min = 0
									max = 200
									value = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_local_exhibition_enthusiasm').GetValue]"
								}
								text_single = {
									raw_text = "@trigger_yes!"
									tooltip = "TV_ARTS_LOCAL_EXHIBITION_HOT_TT"
									align = nobaseline
								}
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = {
									text = "TV_ARTS_LOCAL_EXHIBITION_ENTHUSIASM_LABEL"
									align = nobaseline
								}
								expand = {}
								text_single = {
