# Towards Victory — Arts Exhibition IO Panel
# Shows cultural touring controls plus the three IO leader management actions
# (Appoint / Remove / Change Leader). Domestic exhibitions live in a custom tab.
# The IO's character leader (an artist) is shown in the standard IO header.

organization_panel = {

	blockoverride "organization_overview_tab_visible" {}

	blockoverride "organization_panel_overview_visible" {
		visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
	}

	blockoverride "organization_members_tab_down" {
		down = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	blockoverride "organization_panel_members_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	blockoverride "scroll_overview_empty_visible" { visible = no }

	blockoverride "country_header_character_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet]"
	}
	blockoverride "country_header_character_context" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exhibition_leader_char').GetCharacter]"
	}
	blockoverride "country_header_religion" {}
	blockoverride "extra_titles" {}
	blockoverride "country_header_names_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet]"
	}
	blockoverride "country_header_character_name" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_arts_exhibition_leader_char').GetCharacter]"
		margin = { 2 0 }
		character_label_name = {
			margin_left = 0
			margin_right = 10
			blockoverride "character_name_text" {
				raw_text = "[Character.GetNameToFit('(int32)40', '(bool)yes')]"
			}
		}
	}

	blockoverride "io_main_actions_icon" {
		texture = "gfx/interface/icons/flat_icons/cultural_influence.dds"
	}

	blockoverride "organization_main_actions_extra_visible" {
		visible = yes
	}

	blockoverride "organization_overview_list_custom_top_extra" {
		vbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding

			card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/cultural_influence.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_ARTS_DISPATCHED_ARTISTS_HEADER"
				}

				blockoverride "common_bottom_content" {
					widget = {
						size = { 470 174 }
						datacontext = "[InternationalOrganizationsView.GetPlayer]"

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							margin = { 4 6 }

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								text_single = {
									text = "TV_ARTS_DISPATCHED_COUNT_LABEL"
									align = nobaseline
								}
								expand = {}
								text_single = {
									raw_text = "[Country.MakeScope.GetVariable('tv_dispatched_artists_count').GetValue|0]"
									align = nobaseline
								}
							}

							scrollarea = {
								size = { 458 124 }
								scrollbarpolicy_horizontal = always_off

								scrollbar_vertical = {
									using = Scrollbar_Vertical
								}

								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4
									datamodel = "[Country.MakeScope.GetList('tv_dispatched_artists_list')]"
									item = {
										widget = {
											size = { 97% 48 }
											using = bg_paper_card

											hbox = {
												layoutpolicy_horizontal = expanding
												spacing = 6
												margin = { 6 4 }

												character_frame_small = {
													size = { 40 40 }
													blockoverride "portrait_datacontext" {
														datacontext = "[Scope.GetCharacter]"
													}
												}

												vbox = {
													layoutpolicy_horizontal = expanding
													spacing = 1

													text_single = {
														layoutpolicy_horizontal = expanding
														raw_text = "[Scope.GetCharacter.GetNameToFitWithNoTooltip('(int32)38', '(bool)yes')], [Scope.GetCharacter.GetAgeInYears]"
														align = nobaseline|left
														default_format = "#yellow_titles"
														autoresize = no
													}

													hbox = {
														layoutpolicy_horizontal = expanding
														spacing = 8

														hbox = {
															spacing = 3
															tooltip = "[artistic_skill|e]"
															widget = {
																size = { 22 22 }
																using = icon_art_skill_alt
															}
															text_single = {
																size = { 24 22 }
																raw_text = "[Multiply_CFixedPoint(Scope.GetCharacter.GetArtistSkill, '(CFixedPoint)100')|0]"
																align = nobaseline|left
																default_format = "#important_number"
																autoresize = no
															}
														}

														hbox = {
															spacing = 3
															tooltip = "[work_of_art|e]"
															icon = {
																size = { 22 22 }
																texture = "gfx/interface/icons/flat_icons/art_works.dds"
															}
															text_single = {
																size = { 22 22 }
																text = "[GetDataModelSize(Scope.GetCharacter.GetWorksOfArt)]"
																align = nobaseline|left
																default_format = "#important_number"
																autoresize = no
															}
														}

														hbox = {
															layoutpolicy_horizontal = expanding
															spacing = 3
															datamodel = "[Scope.GetCharacter.GetTraits]"
															item = {
																icon = {
																	size = { 22 22 }
																	using = trait_item
																	blockoverride "trait_item_size" {
																		size = { 22 22 }
																	}
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

	blockoverride "organization_main_actions_extra" {
		# ── Cultural actions ──────────────────────────────────────────────────
		action_button_diamond = {
			size = { 470 30 }
			text = "tv_send_artist_abroad"
			title = "tv_send_artist_abroad"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_send_artist_abroad"
			}
		}

		# ── IO Leader management ──────────────────────────────────────────────
		# Visibility is gated by the appointed-leader country variable on the player.
		action_button_diamond = {
			size = { 470 30 }
			visible = "[Not(Player.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet)]"
			text = "tv_appoint_arts_leader"
			title = "tv_appoint_arts_leader"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_appoint_arts_leader"
			}
		}
		action_button_diamond = {
			size = { 470 30 }
			visible = "[Player.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet]"
			text = "tv_change_arts_leader"
			title = "tv_change_arts_leader"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_change_arts_leader"
			}
		}
		action_button_diamond = {
			size = { 470 30 }
			visible = "[Player.MakeScope.GetVariable('tv_arts_exhibition_leader_char').IsSet]"
			text = "tv_remove_arts_leader"
			title = "tv_remove_arts_leader"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_remove_arts_leader"
			}
		}
	}

	# ── Domestic exhibition tab ───────────────────────────────────────────────
	blockoverride "organization_custom_tab_visible" {
		visible = yes
	}
	blockoverride "organization_custom_tab_text" {
		text = "tv_host_domestic_exhibition"
	}
	blockoverride "organization_custom_tab_tooltip" {
		tooltip = "tv_host_domestic_exhibition_desc"
	}

	blockoverride "organization_custom_content_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'custom' )]"
	}

	blockoverride "organization_custom_content" {
		action_button_diamond = {
			size = { 470 30 }
			text = "tv_host_domestic_exhibition"
			title = "tv_host_domestic_exhibition"
			actor = "[InternationalOrganizationsView.GetPlayer]"
			left_action = {
				action_name = "tv_host_domestic_exhibition"
			}
		}
	}
}
