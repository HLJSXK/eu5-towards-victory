									tooltip = "TV_GOVHOUSE_PLAN_PROGRESS_TOOLTIP"
								}

								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 6
									text_single = {
										text = "TV_GOVHOUSE_PLAN_PROGRESS_LABEL"
										align = nobaseline|left
									}
									expand = {}
									text_single = {
										raw_text = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_govhouse_plan_progress').GetValue|0]/100"
										align = nobaseline|right
									}
								}

								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 6
									text_single = {
										text = "TV_GOVHOUSE_PLAN_MONTHLY_GAIN_LABEL"
										align = nobaseline|left
									}
									expand = {}
									text_single = {
										layoutpolicy_horizontal = expanding
										datacontext = "[InternationalOrganizationsView.GetPlayer]"
										text = "TV_GOVHOUSE_PLAN_MONTHLY_GAIN_FORMULA"
										align = nobaseline|right
									}
								}

								widget = {
									layoutpolicy_horizontal = expanding
									size = { -1 1 }
									background = { using = color_gold  alpha = 0.3 }
								}

								vbox = {
									layoutpolicy_horizontal = expanding
									ignoreinvisible = yes
									spacing = 5
									visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_govhouse_plan_type').GetValue, '(CFixedPoint)1')]"

									text_single = {
										layoutpolicy_horizontal = expanding
										visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_govhouse_plan_target_war_active').GetValue, '(CFixedPoint)0')]"
										datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_govhouse_plan_target').GetCountry]"
										text = "TV_GOVHOUSE_OFFENSIVE_PLAN_PENDING_BONUS_HEADER"
										multiline = yes
										align = nobaseline|left
									}
									text_single = {
										layoutpolicy_horizontal = expanding
										visible = "[EqualTo_CFixedPoint(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_govhouse_plan_target_war_active').GetValue, '(CFixedPoint)1')]"
										datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_govhouse_plan_target').GetCountry]"
										text = "TV_GOVHOUSE_OFFENSIVE_PLAN_ACTIVE_BONUS_HEADER"
										multiline = yes
										align = nobaseline|left
									}

									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 6

										text_single = {
											text = "TV_GOVHOUSE_OFFENSIVE_PLAN_SIEGE_LABEL"
											tooltip = "TV_GOVHOUSE_OFFENSIVE_PLAN_SIEGE_TOOLTIP"
											align = nobaseline|left
										}
										expand = {}
										text_single = {
											datacontext = "[InternationalOrganizationsView.GetPlayer]"
											text = "TV_GOVHOUSE_OFFENSIVE_PLAN_SIEGE_FORMULA"
											tooltip = "TV_GOVHOUSE_OFFENSIVE_PLAN_SIEGE_TOOLTIP"
