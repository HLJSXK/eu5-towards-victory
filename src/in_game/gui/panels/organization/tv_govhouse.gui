								multiline = yes
								align = nobaseline|left
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								ignoreinvisible = yes
								spacing = 5
								visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_govhouse_plan_type').IsSet]"

								text_single = {
									layoutpolicy_horizontal = expanding
