										align = nobaseline|left
									}
								}

								progressbar = {
									size = { 440 16 }
									min = 0
									max = 100
									value = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_govhouse_plan_progress').GetValue]"
