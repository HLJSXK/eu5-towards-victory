									icon = { visible = "[And(GreaterThan_CFixedPoint(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_govhouse_power_balance').GetValue, InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_govhouse_power_equilibrium').GetValue), LessThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_govhouse_power_balance').GetValue, '(CFixedPoint)0.05'))]" parentanchor = left|vcenter position = { 0 0 } size = { 12 12 } texture = "gfx/interface/icons/outliner/arrow_right.dds" mirror = horizontal tooltip = "TV_GOVHOUSE_POWER_BALANCE_TOOLTIP" }
									icon = { visible = "[And3(GreaterThan_CFixedPoint(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_govhouse_power_equilibrium').GetValue, InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_govhouse_power_balance').GetValue), GreaterThan_CFixedPoint(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_govhouse_power_balance').GetValue, '(CFixedPoint)0.05'), LessThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_govhouse_power_balance').GetValue, '(CFixedPoint)0.10'))]" parentanchor = left|vcenter position = { 37 0 } size = { 12 12 } texture = "gfx/interface/icons/outliner/arrow_right.dds" tooltip = "TV_GOVHOUSE_POWER_BALANCE_TOOLTIP" }
									icon = { visible = "[And3(GreaterThan_CFixedPoint(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_govhouse_power_balance').GetValue, InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_govhouse_power_equilibrium').GetValue), GreaterThan_CFixedPoint(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_govhouse_power_balance').GetValue, '(CFixedPoint)0.05'), LessThanOrEqualTo_CFixedPoint(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_govhouse_power_balance').GetValue, '(CFixedPoint)0.10'))]" parentanchor = left|vcenter position = { 18 0 } size = { 12 12 } texture = "gfx/interface/icons/outliner/arrow_right.dds" mirror = horizontal tooltip = "TV_GOVHOUSE_POWER_BALANCE_TOOLTIP" }
