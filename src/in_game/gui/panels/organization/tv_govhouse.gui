										tooltip = "TV_GOVHOUSE_TACTIC_EFFECT_CORRECT_BOX_CHANCE"
									}
									text_single = {
										layoutpolicy_horizontal = expanding
										text = "TV_GOVHOUSE_TACTIC_EFFECT_CORRECT_BOX_CHANCE"
										align = nobaseline|left
									}
									text_single = {
										size = { 76 20 }
										raw_text = "+10%"
										default_format = "#color_green;bold"
										align = nobaseline|right
									}
								}
							}
						}
					}
				}
			}

			card_common = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').IsSet]"
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
