	# -- Grand General tab -----------------------------------------------------
	blockoverride "organization_resolutions_tab_visible" {
		visible = yes
	}
	blockoverride "organization_resolutions_tab_text" {
		text = "TV_GOVHOUSE_GENERAL_TAB"
	}
	blockoverride "organization_resolutions_tooltip" {
		tooltip = "TV_GOVHOUSE_GENERAL_TAB_TOOLTIP"
	}

	blockoverride "organization_resolutions_content" {
		margin = { 0 0 }

		vbox = {
			margin = { 10 0 }
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			ignoreinvisible = yes
			spacing = 10

			card_common = {
				visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').IsSet]"
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/tabicons/military.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_GOVHOUSE_GENERAL_TAB"
				}

				blockoverride "common_bottom_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						ignoreinvisible = yes
						spacing = 6

						io_character_card = {
							visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').IsSet]"
							datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').GetCharacter]"
							using = layoutpolicy_expanding
							blockoverride "name_highlight" {}
							blockoverride "character_entry_name_sort_by_highlight" {}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_gg_training_progress').IsSet]"
							margin = { 8 0 }
							spacing = 6

							text_single = {
								size = { 130 22 }
								text = "TV_GOVHOUSE_TRAINING_PROGRESS_LABEL"
								align = nobaseline|left
							}

							progressbar = {
								size = { 278 16 }
								min = 0
								max = 12
								value = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_gg_training_progress').GetValue]"
								using = progress_bar_blue_alt
								tooltip = "TV_GOVHOUSE_TRAINING_PROGRESS_TOOLTIP"
							}

							text_single = {
								size = { 22 22 }
								raw_text = "@mil!"
								tooltip = "TV_GOVHOUSE_TRAINING_PROGRESS_TOOLTIP"
								align = nobaseline|center
							}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_gg_loyalty_value').IsSet]"
							margin = { 8 0 }
							spacing = 6

							text_single = {
								size = { 130 22 }
								text = "TV_GOVHOUSE_POWER_EQUILIBRIUM_GENERAL_LOYALTY"
								align = nobaseline|left
							}

							progressbar = {
								size = { 278 16 }
								min = 0
								max = 1
								value = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_gg_loyalty_value').GetValue]"
								using = progress_bar_green_alt
								tooltip = "TV_GOVHOUSE_POWER_EQUILIBRIUM_GENERAL_LOYALTY"
							}

							text_single = {
								size = { 22 22 }
								raw_text = "@loyalty!"
								tooltip = "TV_GOVHOUSE_POWER_EQUILIBRIUM_GENERAL_LOYALTY"
								align = nobaseline|center
							}
						}
					}
				}
			}

			card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/tabicons/military.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_GOVHOUSE_POWER_BALANCE_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					widget = {
						size = { 470 170 }

						vbox = {
							layoutpolicy_horizontal = expanding
							margin = { 10 10 }
							spacing = 4

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 10

								icon = {
									size = { 32 32 }
									texture = "gfx/interface/icons/flat_icons/tabicons/military.dds"
									tooltip = "TV_GOVHOUSE_POWER_BALANCE_GENERAL_SIDE"
								}

								widget = {
									size = { 366 18 }
									tooltip = "TV_GOVHOUSE_POWER_BALANCE_TOOLTIP"

									progressbar = {
										size = { 100% 100% }
										min = 0
										max = 1
										value = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_govhouse_power_balance').GetValue]"
										progresstexture = "gfx/interface/progressbars/progress_bar_goldish.dds"
										noprogresstexture = "gfx/interface/progressbars/progress_bar_red_alt.dds"
										texture_density = 2
