				blockoverride "common_header_text" {
					text = "TV_GOVHOUSE_PLAN_CARD_TITLE"
				}

				blockoverride "common_bottom_content" {
					widget = {
						size = { 470 248 }

						vbox = {
							layoutpolicy_horizontal = expanding
							ignoreinvisible = yes
							margin = { 4 6 }
							spacing = 5

							text_single = {
								layoutpolicy_horizontal = expanding
								visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_govhouse_plan_type').IsSet)]"
