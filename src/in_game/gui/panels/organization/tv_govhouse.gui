				}
			}
		}
	}
}

organization_panel = {

	# -- Tab visibility overrides --------------------------------------------
	blockoverride "organization_overview_tab_visible" {}

	blockoverride "organization_panel_overview_visible" {
		visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
	}

	blockoverride "organization_members_tab_down" {
		down = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	blockoverride "organization_panel_members_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	# -- Header: Grand General character portrait -----------------------------
	blockoverride "country_header_character_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').IsSet]"
	}
	blockoverride "country_header_character_context" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').GetCharacter]"
	}
	blockoverride "country_header_religion" {}
	blockoverride "extra_titles" {}
	blockoverride "country_header_names_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').IsSet]"
	}
	blockoverride "country_header_character_name" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').GetCharacter]"
		margin = { 2 0 }
		character_label_name = {
			margin_left = 0
			margin_right = 10
			blockoverride "character_name_text" {
				raw_text = "[Character.GetNameToFit('(int32)40', '(bool)yes')]"
			}
		}
	}

	blockoverride "io_main_actions_icon" {
		texture = "gfx/interface/icons/flat_icons/tabicons/military.dds"
	}

	# -- Tab 1 overview content: Governor Status ------------------------------
	blockoverride "scroll_overview_empty_visible" { visible = no }

	# Replace the default IO action list so Grand General actions live only in
	# their dedicated tab.
	blockoverride "io_overview_actions" {
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10
			margin = { 10 2 }

			card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/tabicons/military.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_GOVHOUSE_GOVERNOR_COUNT"
				}

				blockoverride "common_bottom_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4

						text_single = {
							layoutpolicy_horizontal = expanding
							visible = "[Not(DataModelHasItems(InternationalOrganizationsView.GetPlayer.MakeScope.GetList('tv_govhouse_region_display_list')))]"
							text = "TV_GOVHOUSE_NO_GOVERNOR_REGIONS"
							align = nobaseline|left
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 4
							datamodel = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetList('tv_govhouse_region_display_list')]"
							item = {
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 6
									margin = { 8 6 }

									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 6

										text_single = {
											size = { 22 22 }
											raw_text = "@region!"
											tooltip = "[region|E]"
											align = nobaseline|center
										}

										text_single = {
											layoutpolicy_horizontal = expanding
											datacontext = "[Scope.GetLocation.GetRegion]"
											raw_text = "[Region.GetNameWithNoTooltip]"
											align = nobaseline|left
											tooltipwidget = {
												using = Region_tooltip
											}
										}

										expand = {}

										hbox = {
											visible = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_governor_char').IsSet]"
											spacing = 8

											hbox = {
												spacing = 2
												ignoreinvisible = yes
												icon = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_admin_bonus_type').GetValue, '(CFixedPoint)1.0')]"
													size = { 20 20 }
													texture = "gfx/interface/icons/modifier_types/global_max_control.dds"
													tooltip = "TV_GOVHOUSE_ADMIN_CONTROL_FORMULA_TT"
												}
												icon = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_admin_bonus_type').GetValue, '(CFixedPoint)2.0')]"
													size = { 20 20 }
													texture = "gfx/interface/icons/location_icons/development.dds"
													tooltip = "TV_GOVHOUSE_ADMIN_DEVELOPMENT_FORMULA_TT"
												}
												icon = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_admin_bonus_type').GetValue, '(CFixedPoint)3.0')]"
													size = { 20 20 }
													texture = "gfx/interface/icons/flat_icons/building_panel/production_efficiency.dds"
													tooltip = "TV_GOVHOUSE_ADMIN_PRODUCTION_FORMULA_TT"
												}
												text_single = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_admin_bonus_type').GetValue, '(CFixedPoint)1.0')]"
													size = { 46 22 }
													raw_text = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_admin_bonus_value').GetValue|+=%0]"
													tooltip = "TV_GOVHOUSE_ADMIN_CONTROL_FORMULA_TT"
													align = nobaseline|right
												}
												text_single = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_admin_bonus_type').GetValue, '(CFixedPoint)2.0')]"
													size = { 46 22 }
													raw_text = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_admin_bonus_value').GetValue|+=4]"
													tooltip = "TV_GOVHOUSE_ADMIN_DEVELOPMENT_FORMULA_TT"
													align = nobaseline|right
												}
												text_single = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_admin_bonus_type').GetValue, '(CFixedPoint)3.0')]"
													size = { 46 22 }
													raw_text = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_admin_bonus_value').GetValue|+=%0]"
													tooltip = "TV_GOVHOUSE_ADMIN_PRODUCTION_FORMULA_TT"
													align = nobaseline|right
												}
											}

											hbox = {
												spacing = 2
												ignoreinvisible = yes
												icon = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_dip_bonus_type').GetValue, '(CFixedPoint)1.0')]"
													size = { 20 20 }
													texture = "gfx/interface/icons/modifier_types/small_foreign_building_cost_modifier.dds"
													tooltip = "TV_GOVHOUSE_DIP_CONSTRUCTION_FORMULA_TT"
												}
												icon = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_dip_bonus_type').GetValue, '(CFixedPoint)2.0')]"
													size = { 20 20 }
													texture = "gfx/interface/icons/alerts_icons/lack_pop_promotion_to_fill_buildings.dds"
													tooltip = "TV_GOVHOUSE_DIP_POP_PROMOTION_FORMULA_TT"
												}
												icon = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_dip_bonus_type').GetValue, '(CFixedPoint)3.0')]"
													size = { 20 20 }
													texture = "gfx/interface/icons/location_icons/new/population_growth.dds"
													tooltip = "TV_GOVHOUSE_DIP_POP_GROWTH_FORMULA_TT"
												}
												text_single = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_dip_bonus_type').GetValue, '(CFixedPoint)1.0')]"
													size = { 46 22 }
													raw_text = "[Multiply_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_dip_bonus_value').GetValue, '(CFixedPoint)-1')|-=%0]"
													tooltip = "TV_GOVHOUSE_DIP_CONSTRUCTION_FORMULA_TT"
													align = nobaseline|right
												}
												text_single = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_dip_bonus_type').GetValue, '(CFixedPoint)2.0')]"
													size = { 46 22 }
													raw_text = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_dip_bonus_value').GetValue|+=%0]"
													tooltip = "TV_GOVHOUSE_DIP_POP_PROMOTION_FORMULA_TT"
													align = nobaseline|right
												}
												text_single = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_dip_bonus_type').GetValue, '(CFixedPoint)3.0')]"
													size = { 46 22 }
													raw_text = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_dip_bonus_value').GetValue|+=%3]"
													tooltip = "TV_GOVHOUSE_DIP_POP_GROWTH_FORMULA_TT"
													align = nobaseline|right
												}
											}

											hbox = {
												spacing = 2
												ignoreinvisible = yes
												icon = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_mil_bonus_type').GetValue, '(CFixedPoint)1.0')]"
													size = { 20 20 }
													texture = "gfx/interface/icons/modifier_types/local_unrest.dds"
													tooltip = "TV_GOVHOUSE_MIL_UNREST_FORMULA_TT"
												}
												icon = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_mil_bonus_type').GetValue, '(CFixedPoint)2.0')]"
													size = { 20 20 }
													texture = "gfx/interface/icons/unit_category/army_levies.dds"
													tooltip = "TV_GOVHOUSE_MIL_LEVY_FORMULA_TT"
												}
												icon = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_mil_bonus_type').GetValue, '(CFixedPoint)3.0')]"
													size = { 20 20 }
													texture = "gfx/interface/icons/military_stances/defensive_military_stance.dds"
													tooltip = "TV_GOVHOUSE_MIL_FORT_FORMULA_TT"
												}
												text_single = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_mil_bonus_type').GetValue, '(CFixedPoint)1.0')]"
													size = { 46 22 }
													raw_text = "[Multiply_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_mil_bonus_value').GetValue, '(CFixedPoint)-1')|-=%0]"
													tooltip = "TV_GOVHOUSE_MIL_UNREST_FORMULA_TT"
													align = nobaseline|right
												}
												text_single = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_mil_bonus_type').GetValue, '(CFixedPoint)2.0')]"
													size = { 46 22 }
													raw_text = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_mil_bonus_value').GetValue|+=%0]"
													tooltip = "TV_GOVHOUSE_MIL_LEVY_FORMULA_TT"
													align = nobaseline|right
												}
												text_single = {
													visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_mil_bonus_type').GetValue, '(CFixedPoint)3.0')]"
													size = { 46 22 }
													raw_text = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_mil_bonus_value').GetValue|+=%0]"
													tooltip = "TV_GOVHOUSE_MIL_FORT_FORMULA_TT"
													align = nobaseline|right
												}
											}
										}

										text_single = {
											visible = "[Not(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_governor_char').IsSet)]"
											text = "TV_GOVHOUSE_NO_GOVERNOR_ASSIGNED"
											align = nobaseline|right
										}
									}

									io_character_card = {
										visible = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_governor_char').IsSet]"
										datacontext = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_governor_char').GetCharacter]"
										using = layoutpolicy_expanding
										blockoverride "name_highlight" {}
										blockoverride "character_entry_name_sort_by_highlight" {}
									}

									hbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = fixed
										visible = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_governor_char').IsSet]"
										datacontext = "[Scope.GetLocation]"
										margin = { 8 0 }
										spacing = 6
										using = bg_paper_card
										using = bg_cabinet_card_frame
										tooltipwidget = {
											using = tv_govhouse_autonomous_task_tooltip
										}

										text_single = {
											layoutpolicy_horizontal = expanding
											visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)1.0')]"
											text = "TV_GOVHOUSE_TASK_RESTORE_PROSPERITY_ACTIVE"
											align = nobaseline|left
										}
										text_single = {
											layoutpolicy_horizontal = expanding
											visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)2.0')]"
											text = "TV_GOVHOUSE_TASK_INTEGRATE_REGION_ACTIVE"
											align = nobaseline|left
										}
										text_single = {
											layoutpolicy_horizontal = expanding
											visible = "[EqualTo_CFixedPoint(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)3.0')]"
											text = "TV_GOVHOUSE_TASK_CONVERT_CULTURE_ACTIVE"
											align = nobaseline|left
										}
