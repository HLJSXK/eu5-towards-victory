# Towards Victory - Governor's House IO Panel
# Overview tab: governor appointment and governor status list.
# Custom tab: Grand General management, backed by tv_conquest_general_char.

organization_panel = {

	# -- Tab visibility overrides --------------------------------------------
	blockoverride "organization_overview_tab_visible" {}

	blockoverride "organization_panel_overview_visible" {
		visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
	}

	blockoverride "organization_members_tab_down" {
		down = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	blockoverride "organization_panel_members_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}

	# -- Header: Grand General character portrait -----------------------------
	blockoverride "country_header_character_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').IsSet]"
	}
	blockoverride "country_header_character_context" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').GetCharacter]"
	}
	blockoverride "country_header_religion" {}
	blockoverride "extra_titles" {}
	blockoverride "country_header_names_visible" {
		visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').IsSet]"
	}
	blockoverride "country_header_character_name" {
		datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').GetCharacter]"
		margin = { 2 0 }
		character_label_name = {
			margin_left = 0
			margin_right = 10
			blockoverride "character_name_text" {
				raw_text = "[Character.GetNameToFit('(int32)40', '(bool)yes')]"
			}
		}
	}

	blockoverride "io_main_actions_icon" {
		texture = "gfx/interface/icons/flat_icons/tabicons/military.dds"
	}

	# -- Tab 1 overview content: Governor Status ------------------------------
	blockoverride "scroll_overview_empty_visible" { visible = no }

	# Replace the default IO action list so Grand General actions live only in
	# their dedicated tab.
	blockoverride "io_overview_actions" {
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10
			margin = { 10 2 }

			card_common = {
				maximumsize = { 500 -1 }

				blockoverride "common_header_icon_texture" {
					texture = "gfx/interface/icons/flat_icons/tabicons/military.dds"
				}

				blockoverride "common_header_text" {
					text = "TV_GOVHOUSE_GOVERNOR_COUNT"
				}

				blockoverride "common_bottom_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4

						text_single = {
							layoutpolicy_horizontal = expanding
							visible = "[Not(InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_govhouse_region_list').IsSet)]"
							text = "TV_GOVHOUSE_NO_GOVERNOR_REGIONS"
							align = nobaseline|left
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 4
							datamodel = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetList('tv_govhouse_region_display_list')]"
							item = {
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 6
									margin = { 8 6 }

									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 6

										text_single = {
											size = { 22 22 }
											raw_text = "@region!"
											tooltip = "[region|E]"
											align = nobaseline|center
										}

										text_single = {
											layoutpolicy_horizontal = expanding
											datacontext = "[Scope.GetLocation.GetRegion]"
											raw_text = "[Region.GetNameWithNoTooltip]"
											align = nobaseline|left
											tooltipwidget = {
												using = Region_tooltip
											}
										}

										expand = {}

										hbox = {
											visible = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_governor_char').IsSet]"
											spacing = 8

											hbox = {
												spacing = 2
												text_single = {
													size = { 20 22 }
													raw_text = "@max_control!"
													tooltip = "[max_control|E]"
													align = nobaseline|center
												}
												text_single = {
													size = { 46 22 }
													raw_text = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_max_control_pct').GetValue|+=%0]"
													tooltip = "TV_GOVHOUSE_MAX_CONTROL_FORMULA_TT"
													align = nobaseline|right
												}
											}

											hbox = {
												spacing = 2
												text_single = {
													size = { 20 22 }
													raw_text = "@construction!"
													tooltip = "[construction|E]"
													align = nobaseline|center
												}
												text_single = {
													size = { 46 22 }
													raw_text = "-[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_build_cost_pct').GetValue|%0]"
													tooltip = "TV_GOVHOUSE_BUILD_COST_FORMULA_TT"
													align = nobaseline|right
												}
											}

											hbox = {
												spacing = 2
												icon = {
													size = { 18 18 }
													texture = "gfx/interface/icons/flat_icons/geography/unrest.dds"
													tooltip = "[unrest|E]"
												}
												text_single = {
													size = { 46 22 }
													raw_text = "-[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_unrest_pct').GetValue|%0]"
													tooltip = "TV_GOVHOUSE_UNREST_FORMULA_TT"
													align = nobaseline|right
												}
											}
										}

										text_single = {
											visible = "[Not(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_governor_char').IsSet)]"
											text = "TV_GOVHOUSE_NO_GOVERNOR_ASSIGNED"
											align = nobaseline|right
										}
									}

									io_character_card = {
										visible = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_governor_char').IsSet]"
										datacontext = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_governor_char').GetCharacter]"
										using = layoutpolicy_expanding
										blockoverride "name_highlight" {}
										blockoverride "character_entry_name_sort_by_highlight" {}
									}

									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 6

										action_button_diamond = {
											size = { 130 24 }
											visible = "[Not(Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_governor_char').IsSet)]"
											text = "tv_appoint_governor"
											title = "tv_appoint_governor"
											actor = "[InternationalOrganizationsView.GetPlayer]"
											left_action = {
												action_name = "tv_appoint_governor"
												parameter = {
													parameter_name = "target_1"
													parameter_value = "[Scope.GetLocation.GetRegion]"
												}
											}
										}

										action_button_diamond = {
											size = { 130 24 }
											visible = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_governor_char').IsSet]"
											text = "tv_remove_governor"
											title = "tv_remove_governor"
											actor = "[InternationalOrganizationsView.GetPlayer]"
											left_action = {
												action_name = "tv_remove_governor"
												parameter = {
													parameter_name = "target_1"
													parameter_value = "[Scope.GetLocation.GetRegion]"
												}
											}
										}

										action_button_diamond = {
											size = { 130 24 }
											visible = "[Scope.GetLocation.MakeScope.GetVariable('tv_govhouse_display_governor_char').IsSet]"
											text = "tv_change_governor"
											title = "tv_change_governor"
											actor = "[InternationalOrganizationsView.GetPlayer]"
											left_action = {
												action_name = "tv_change_governor"
												parameter = {
													parameter_name = "target_1"
													parameter_value = "[Scope.GetLocation.GetRegion]"
												}
											}
										}

										expand = {}
									}

									widget = {
										layoutpolicy_horizontal = expanding
										size = { -1 1 }
										using = bg_divider_flavor_01
									}
								}
							}
						}
					}
				}
			}
		}
	}

	# -- Grand General tab -----------------------------------------------------
	blockoverride "organization_custom_tab_visible" {
		visible = yes
	}
	blockoverride "organization_custom_tab_text" {
		text = "TV_GOVHOUSE_GENERAL_TAB"
	}
	blockoverride "organization_custom_tab_tooltip" {
		tooltip = "TV_GOVHOUSE_GENERAL_TAB_TOOLTIP"
	}

	blockoverride "organization_custom_content_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'custom' )]"
	}

	blockoverride "organization_custom_content" {

		card_common = {
			visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').IsSet]"
			maximumsize = { 500 -1 }

			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/flat_icons/tabicons/military.dds"
			}

			blockoverride "common_header_text" {
				text = "TV_GOVHOUSE_GENERAL_TAB"
			}

			blockoverride "common_bottom_content" {
				io_character_card = {
					visible = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').IsSet]"
					datacontext = "[InternationalOrganizationsView.GetPlayer.MakeScope.GetVariable('tv_conquest_general_char').GetCharacter]"
					using = layoutpolicy_expanding
					blockoverride "name_highlight" {}
					blockoverride "character_entry_name_sort_by_highlight" {}
				}
			}
		}

		card_common = {
			maximumsize = { 500 -1 }

			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/flat_icons/tabicons/military.dds"
			}

			blockoverride "common_header_text" {
				text = "TV_GOVHOUSE_POWER_BALANCE_CARD_TITLE"
			}

			blockoverride "common_bottom_content" {
				widget = {
					size = { 470 54 }

					hbox = {
						margin = { 10 10 }
						spacing = 10

						icon = {
							size = { 32 32 }
							texture = "gfx/interface/icons/flat_icons/tabicons/military.dds"
							tooltip = "TV_GOVHOUSE_POWER_BALANCE_GENERAL_SIDE"
						}

						progressbar = {
							size = { 366 18 }
							min = 0
							max = 1
							value = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('tv_govhouse_power_balance').GetValue]"
							progresstexture = "gfx/interface/progressbars/progress_bar_blue_alt_left.dds"
							noprogresstexture = "gfx/interface/progressbars/progress_bar_goldish.dds"
							texture_density = 2
							spriteType = Corneredstretched
							spriteborder = { 12 0 }
							tooltip = "TV_GOVHOUSE_POWER_BALANCE_TOOLTIP"
						}

						icon = {
							size = { 32 32 }
							texture = "gfx/interface/icons/estates/crown_estate.dds"
							tooltip = "TV_GOVHOUSE_POWER_BALANCE_CROWN_SIDE"
						}
					}
				}
			}
		}

		card_actions = {
			minimumsize = { 500 190 }
			maximumsize = { 500 190 }

			blockoverride "card_header_text" {
				text = "MAIN_ACTIONS"
			}

			blockoverride "card_header_icon" {
				block "io_main_actions_icon" {
					texture = "gfx/interface/icons/flat_icons/tabicons/military.dds"
				}
			}

			blockoverride "actions_override" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2

					action_button_diamond = {
						size = { 470 30 }
						visible = "[Not(Player.MakeScope.GetVariable('tv_conquest_general_char').IsSet)]"
						text = "tv_appoint_conquest_general_leader"
						title = "tv_appoint_conquest_general_leader"
						actor = "[InternationalOrganizationsView.GetPlayer]"
						left_action = {
							action_name = "tv_appoint_conquest_general_leader"
						}
					}
					action_button_diamond = {
						size = { 470 30 }
						visible = "[Player.MakeScope.GetVariable('tv_conquest_general_char').IsSet]"
						text = "tv_change_conquest_general_leader"
						title = "tv_change_conquest_general_leader"
						actor = "[InternationalOrganizationsView.GetPlayer]"
						left_action = {
							action_name = "tv_change_conquest_general_leader"
						}
					}
					action_button_diamond = {
						size = { 470 30 }
						visible = "[Player.MakeScope.GetVariable('tv_conquest_general_char').IsSet]"
						text = "tv_remove_conquest_general_leader"
						title = "tv_remove_conquest_general_leader"
						actor = "[InternationalOrganizationsView.GetPlayer]"
						left_action = {
							action_name = "tv_remove_conquest_general_leader"
						}
					}
					action_button_diamond = {
						size = { 470 30 }
						visible = "[Player.MakeScope.GetVariable('tv_conquest_general_char').IsSet]"
						text = "tv_train_grand_general"
						title = "tv_train_grand_general"
						actor = "[InternationalOrganizationsView.GetPlayer]"
						left_action = {
							action_name = "tv_train_grand_general"
						}
					}
				}
			}
		}
	}
}
