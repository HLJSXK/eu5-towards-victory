# Towards Victory - Governor's House IO Panel
# Overview tab: governor appointment and governor status list.
# Resolutions tab: Grand General management, backed by tv_conquest_general_char.
# Custom tab: War Tent tactics and war plans.

template tv_govhouse_autonomous_task_tooltip {
	ContextualTooltipType = {
		blockoverride "tooltip_title" {}
		blockoverride "tooltip_content_margin" { margin = { 8 8 } }
		blockoverride "tooltip_content" {
			vbox = {
				spacing = 6

				widget = {
					minimumsize = { 420 44 }
					maximumsize = { 420 44 }
					using = bg_paper_card
					using = bg_cabinet_card_frame

					text_single = {
						parentanchor = center
						widgetanchor = center
						visible = "[EqualTo_CFixedPoint(Location.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)1.0')]"
						text = "TV_GOVHOUSE_TASK_RESTORE_PROSPERITY_TOOLTIP_TITLE"
						align = center|nobaseline
						fontsize = 16
					}
					text_single = {
						parentanchor = center
						widgetanchor = center
						visible = "[EqualTo_CFixedPoint(Location.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)2.0')]"
						text = "TV_GOVHOUSE_TASK_INTEGRATE_REGION_TOOLTIP_TITLE"
						align = center|nobaseline
						fontsize = 16
					}
					text_single = {
						parentanchor = center
						widgetanchor = center
						visible = "[EqualTo_CFixedPoint(Location.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)3.0')]"
						text = "TV_GOVHOUSE_TASK_CONVERT_CULTURE_TOOLTIP_TITLE"
						align = center|nobaseline
						fontsize = 16
					}
					text_single = {
						parentanchor = center
						widgetanchor = center
						visible = "[EqualTo_CFixedPoint(Location.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)4.0')]"
						text = "TV_GOVHOUSE_TASK_CONVERT_RELIGION_TOOLTIP_TITLE"
						align = center|nobaseline
						fontsize = 16
					}
					text_single = {
						parentanchor = center
						widgetanchor = center
						visible = "[EqualTo_CFixedPoint(Location.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)5.0')]"
						text = "TV_GOVHOUSE_TASK_STRENGTHEN_RECRUITMENT_TOOLTIP_TITLE"
						align = center|nobaseline
						fontsize = 16
					}
					text_single = {
						parentanchor = center
						widgetanchor = center
						visible = "[EqualTo_CFixedPoint(Location.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)6.0')]"
						text = "TV_GOVHOUSE_TASK_STRENGTHEN_ORDER_TOOLTIP_TITLE"
						align = center|nobaseline
						fontsize = 16
					}
				}

				widget = {
					layoutpolicy_vertical = fixed
					minimumsize = { 420 96 }
					maximumsize = { 420 96 }
					using = bg_paper_card
					using = bg_cabinet_card_frame

					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 14 10 }
						spacing = 4

						text_single = {
							text = "TV_GOVHOUSE_TASK_TOOLTIP_DESCRIPTION_HEADER"
							fontsize = 15
							align = nobaseline|left
						}
						text_multi = {
							layoutpolicy_horizontal = expanding
							max_width = 392
							autoresize = yes
							visible = "[EqualTo_CFixedPoint(Location.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)1.0')]"
							text = "TV_GOVHOUSE_TASK_RESTORE_PROSPERITY_TOOLTIP_DESC"
						}
						text_multi = {
							layoutpolicy_horizontal = expanding
							max_width = 392
							autoresize = yes
							visible = "[EqualTo_CFixedPoint(Location.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)2.0')]"
							text = "TV_GOVHOUSE_TASK_INTEGRATE_REGION_TOOLTIP_DESC"
						}
						text_multi = {
							layoutpolicy_horizontal = expanding
							max_width = 392
							autoresize = yes
							visible = "[EqualTo_CFixedPoint(Location.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)3.0')]"
							text = "TV_GOVHOUSE_TASK_CONVERT_CULTURE_TOOLTIP_DESC"
						}
						text_multi = {
							layoutpolicy_horizontal = expanding
							max_width = 392
							autoresize = yes
							visible = "[EqualTo_CFixedPoint(Location.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)4.0')]"
							text = "TV_GOVHOUSE_TASK_CONVERT_RELIGION_TOOLTIP_DESC"
						}
						text_multi = {
							layoutpolicy_horizontal = expanding
							max_width = 392
							autoresize = yes
							visible = "[EqualTo_CFixedPoint(Location.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)5.0')]"
							text = "TV_GOVHOUSE_TASK_STRENGTHEN_RECRUITMENT_TOOLTIP_DESC"
						}
						text_multi = {
							layoutpolicy_horizontal = expanding
							max_width = 392
							autoresize = yes
							visible = "[EqualTo_CFixedPoint(Location.MakeScope.GetVariable('tv_govhouse_display_task_type').GetValue, '(CFixedPoint)6.0')]"
							text = "TV_GOVHOUSE_TASK_STRENGTHEN_ORDER_TOOLTIP_DESC"
						}
					}
				}

				widget = {
					minimumsize = { 420 36 }
					maximumsize = { 420 36 }
					using = bg_paper_card
					using = bg_cabinet_card_frame

					hbox = {
						size = { 100% 100% }
						layoutpolicy_horizontal = expanding
						spacing = 8
						margin = { 12 0 }

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "TV_GOVHOUSE_TASK_RESTORE_PROSPERITY_TOOLTIP_LABEL"
							align = nobaseline|left
						}
						text_single = {
							size = { 72 22 }
							raw_text = "[Location.MakeScope.GetVariable('tv_govhouse_display_weight_restore_prosperity').GetValue|%1]"
							align = nobaseline|right
						}
					}
				}

				widget = {
					minimumsize = { 420 36 }
					maximumsize = { 420 36 }
					using = bg_paper_card
					using = bg_cabinet_card_frame

					hbox = {
						size = { 100% 100% }
						layoutpolicy_horizontal = expanding
						spacing = 8
						margin = { 12 0 }

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "TV_GOVHOUSE_TASK_INTEGRATE_REGION_TOOLTIP_LABEL"
							align = nobaseline|left
						}
						text_single = {
							size = { 72 22 }
							raw_text = "[Location.MakeScope.GetVariable('tv_govhouse_display_weight_integrate_region').GetValue|%1]"
							align = nobaseline|right
						}
					}
				}

				widget = {
					minimumsize = { 420 36 }
					maximumsize = { 420 36 }
					using = bg_paper_card
					using = bg_cabinet_card_frame

					hbox = {
						size = { 100% 100% }
						layoutpolicy_horizontal = expanding
						spacing = 8
						margin = { 12 0 }

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "TV_GOVHOUSE_TASK_CONVERT_CULTURE_TOOLTIP_LABEL"
							align = nobaseline|left
						}
						text_single = {
							size = { 72 22 }
							raw_text = "[Location.MakeScope.GetVariable('tv_govhouse_display_weight_convert_culture').GetValue|%1]"
							align = nobaseline|right
						}
					}
				}

				widget = {
					minimumsize = { 420 36 }
					maximumsize = { 420 36 }
					using = bg_paper_card
					using = bg_cabinet_card_frame

					hbox = {
						size = { 100% 100% }
						layoutpolicy_horizontal = expanding
						spacing = 8
						margin = { 12 0 }

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "TV_GOVHOUSE_TASK_CONVERT_RELIGION_TOOLTIP_LABEL"
							align = nobaseline|left
						}
						text_single = {
							size = { 72 22 }
							raw_text = "[Location.MakeScope.GetVariable('tv_govhouse_display_weight_convert_religion').GetValue|%1]"
							align = nobaseline|right
						}
					}
				}

				widget = {
					minimumsize = { 420 36 }
					maximumsize = { 420 36 }
					using = bg_paper_card
					using = bg_cabinet_card_frame

					hbox = {
						size = { 100% 100% }
						layoutpolicy_horizontal = expanding
						spacing = 8
						margin = { 12 0 }

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "TV_GOVHOUSE_TASK_STRENGTHEN_RECRUITMENT_TOOLTIP_LABEL"
							align = nobaseline|left
						}
						text_single = {
							size = { 72 22 }
							raw_text = "[Location.MakeScope.GetVariable('tv_govhouse_display_weight_strengthen_recruitment').GetValue|%1]"
							align = nobaseline|right
						}
					}
				}

				widget = {
					minimumsize = { 420 36 }
					maximumsize = { 420 36 }
					using = bg_paper_card
					using = bg_cabinet_card_frame

					hbox = {
						size = { 100% 100% }
						layoutpolicy_horizontal = expanding
						spacing = 8
						margin = { 12 0 }

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "TV_GOVHOUSE_TASK_STRENGTHEN_ORDER_TOOLTIP_LABEL"
							align = nobaseline|left
						}
						text_single = {
							size = { 72 22 }
							raw_text = "[Location.MakeScope.GetVariable('tv_govhouse_display_weight_strengthen_order').GetValue|%1]"
							align = nobaseline|right
						}
