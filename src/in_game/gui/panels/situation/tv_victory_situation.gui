# ══════════════════════════════════════════════════════════════════════════
# MAIN SITUATION PANEL
# situation_card_common root widget — displays when player opens this situation.
# Header title is automatically sourced from tv_victory_situation loc key.
# ══════════════════════════════════════════════════════════════════════════

situation_panel = {

	blockoverride "situation_panel_main_content" {
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6
			margin = { 8 8 }
			datacontext = "[SituationView.GetPlayer]"

			# ── SECTION 1: Flavor Introduction ──────────────────────────────────────────
			vbox = {
				layoutpolicy_horizontal = expanding
				background = {
					texture = "gfx/interface/component_tiles/square_tile.dds"
					alpha = 0.10
					spriteType = CorneredStretched
					spriteborder = { 4 4 }
				}
				text_multi = {
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 380
					text = "TV_SECTION1_FLAVOR"
					align = center
					margin = { 8 6 }
					fontsize = 14
				}
			}
			widget = { size = { -1 1 } background = { using = color_gold  alpha = 0.3 } }

			# ── SECTION 2: Victory Progress Rows ─────────────────────────────────────────
