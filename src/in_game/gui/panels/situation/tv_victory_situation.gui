# Towards Victory — Victory Progress Situation Panel
# Generated by scripts/gen_victory_scaffold.py
#
# Verification — Step 2, Reference: cards.gui:1118
#   situation_card_common extends card_common with bg_card_header_01 header.
#   Valid blockoverride targets on card_common:
#     header_size, header_decor_templates, common_header_back_decor,
#     common_header_extra_left, common_header, common_header_extra_right,
#     card_common_bottom_margin, common_bottom_content
#
# GUI file name MUST match the situation identifier: tv_victory_situation

types TVVictoryTypes {

	# tv_victory_row — reusable row template for one victory path.
	# Parameterised via block overrides per instance (6 total):
	#   row_progress_value   : progressbar value expression
	#   row_progress_style   : progressbar texture template
	#   path_icon_circle     : large victory-type icon circle (44x44)
	#   milestone_1_circle   : M1 circle (30x30)
	#   milestone_2_circle   : M2 circle (30x30)
	#   milestone_v1_circle  : V1 Short-term Victory circle (34x34, special)
	#   milestone_4_circle   : M4 circle (30x30)
	#   milestone_v2_circle  : V2 Long-term Victory circle (38x38, special)
	type tv_victory_row = widget {
		size = { -1 52 }
		layoutpolicy_horizontal = expanding

		# Subtle row background for visual separation between paths
		background = {
			texture = "gfx/interface/component_tiles/square_tile.dds"
			alpha = 0.08
			spriteType = CorneredStretched
			spriteborder = { 4 4 }
		}

		# ── Layer 1: progress bar (rendered first — behind marker circles) ──────
		progressbar = {
			parentanchor = vcenter
			size = { 100% 14 }
			max = 100
			block "row_progress_value" { value = 0 }
			block "row_progress_style" { using = progress_bar_blue_alt }
		}

		# ── Layer 2: icon + milestone circles (rendered on top of bar) ──────────
		hbox = {
			size = { -1 100% }
			layoutpolicy_horizontal = expanding

			# Victory-type icon (44x44, overlaps bar start)
			block "path_icon_circle" { }
			expand = { }
			# Milestone 1 (30x30, ~20% of bar width)
			block "milestone_1_circle" { }
			expand = { }
			# Milestone 2 (30x30, ~40%)
			block "milestone_2_circle" { }
			expand = { }
			# V1 Short-term Victory (34x34, ~60%, special gold frame)
			block "milestone_v1_circle" { }
			expand = { }
			# Milestone 4 (30x30, ~80%)
			block "milestone_4_circle" { }
			expand = { }
			# V2 Long-term Victory (38x38, ~100%, special gold frame)
			block "milestone_v2_circle" { }
		}

		block "row_progress_tooltip" { }
	}
}

