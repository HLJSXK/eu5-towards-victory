# ══════════════════════════════════════════════════════════════════════════
# MILESTONE TOOLTIPS (30 total — 6 paths x 5 milestones)
# 3-panel design:
#   Panel 1: what this milestone position means (plain description)
#   Panel 2: conditions to reach it (standard requirements list display)
#   Panel 3: rewards upon achievement (standard modifier pair display)
# ══════════════════════════════════════════════════════════════════════════

# ── Conquest Victory milestones ──────────────────────────────────────────────

template tv_conquest_milestone_1_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" { text = "TV_CONQUEST_M1_TITLE" }
		blockoverride "tooltip_content" {

			# ── Panel 1: what this milestone position means ────────────────────
			TooltipTextBlock = {
				blockoverride "text" { text = "TV_CONQUEST_M1_MEANING" }
			}

			# Visual separator between panels
			widget = { size = { -1 1 } background = { using = color_gold  alpha = 0.3 } }

			# ── Panel 2: conditions to reach this milestone ────────────────────
			TooltipScrolledRequirementsList = {
				blockoverride "block_title" { text = "TV_TOOLTIP_CONDITIONS_HEADER" }
				textcontext = "[ShowTriggerConditions('tv_conquest_milestone_1', PlayerScope.Self)]"
			}

			# Visual separator between panels
			widget = { size = { -1 1 } background = { using = color_gold  alpha = 0.3 } }

			# ── Panel 3: rewards upon reaching this milestone ──────────────────
			TooltipRowList = {
				blockoverride "block_title" { text = "TV_TOOLTIP_REWARDS_HEADER" }
				textcontext = "[GetModifier('tv_conquest_m1_bonus').GetDesc]"
			}

		}
	}
}

