# VICTORY TYPE ICON TOOLTIPS (6 total)
# Shows: short description of the victory path + flavor text.
# ══════════════════════════════════════════════════════════════════════════

template tv_conquest_icon_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" { text = "TV_CONQUEST_TITLE" }
		blockoverride "title_icon_texture" {
			texture = "gfx/interface/icons/flat_icons/tabicons/military.dds"
		}
		blockoverride "concept_link" { text = "[situation|E]" }
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" { text = "TV_CONQUEST_DESCRIPTION" }
			}
			TooltipFlavorTextBlock = {
				blockoverride "text" { text = "TV_CONQUEST_FLAVOR" }
			}
		}
	}
}

