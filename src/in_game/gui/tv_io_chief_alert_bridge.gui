widget = {
	name = "tv_io_chief_alert_bridge"
	size = { 0 0 }
	visible_at_creation = no
	visible = "[GetPlayer.MakeScope.GetVariable('tv_io_chief_alert_open_requested').IsSet]"

	state = {
		name = _show
		on_start = "[GetScriptedGui('tv_clear_io_chief_alert_open_request').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}
}
